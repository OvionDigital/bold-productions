# Zet op 'true' om Google Tag Manager en CookieFirst te laden (nog niet geimplementeerd)
PUBLIC_ENABLE_TRACKING=false

# Endpoint voor het contactformulier (POST, FormData). TODO: backend kiezen.
PUBLIC_CONTACT_ENDPOINT=

# Sanity CMS (zie docs/sanity.md). Zonder deze twee variabelen valt de homepage
# terug op src/data/home.ts en worden er geen CMS-pagina's gebouwd, dus lokaal
# ontwikkelen zonder Sanity blijft gewoon werken.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Alleen voor de scripts (seed, migraties); de site zelf gebruikt het niet. Nooit PUBLIC_ maken.
# Aanmaken via sanity.io/manage → API → Tokens (Editor).
SANITY_API_WRITE_TOKEN=
# Alleen voor het live voorbeeld in Studio (npm run preview:dev / preview:deploy, zie
# docs/sanity.md → Live voorbeeld): token met Viewer-rechten om concepten te lezen.
# Komt in de server-bundel van de Worker; daarom nooit het schrijf-token.
SANITY_API_READ_TOKEN=
