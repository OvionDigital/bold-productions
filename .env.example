# Zet op 'true' om Google Tag Manager en CookieFirst te laden (nog niet geimplementeerd)
PUBLIC_ENABLE_TRACKING=false

# Endpoint voor het contactformulier (POST, FormData). TODO: backend kiezen.
PUBLIC_CONTACT_ENDPOINT=

# Sanity CMS (proef, alleen homepage — zie docs/sanity.md). Zonder deze twee
# variabelen valt de site terug op src/data/home.ts, dus lokaal ontwikkelen
# zonder Sanity blijft gewoon werken.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Alleen nodig voor het seed-script (studio/npm run seed) en voor concepten
# ophalen; nooit PUBLIC_ maken. Aanmaken via sanity.io/manage → API → Tokens (Editor).
SANITY_API_WRITE_TOKEN=
