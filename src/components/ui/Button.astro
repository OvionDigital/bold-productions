---
/**
 * Knop of link met knopstijl.
 *
 * Kapitalen in de body-font met ruime letterspatiëring, 2px rand en een effen "veeg" bij
 * hover: de vulling loopt van links naar rechts in, of van boven naar onder als de knop
 * een pijl omlaag heeft (icon="arrow-down"). Geen gradients.
 *
 * Varianten (Webflow-klasse → variant):
 *   .button.orange / .button.yellow → primary  (accentvlak; bij hover zwart met accenttekst)
 *   .button.orange-outline          → outline  (accentrand; bij hover accentvlak, zwarte tekst)
 *   .button.white-outline           → ghost    (donker glas; bij hover wit vlak, zwarte tekst)
 * Kleur volgt het accent (data-accent op een voorouder) of de `accent`-prop.
 */
import type { HTMLAttributes } from "astro/types";
import Icon, { type IconName } from "./Icon.astro";

export type ButtonVariant = "primary" | "outline" | "ghost";
export type ButtonSize = "compact" | "small" | "default" | "large";
export type Accent = "orange" | "yellow" | "green";

interface Props {
  label: string;
  href?: string;
  variant?: ButtonVariant;
  size?: ButtonSize;
  accent?: Accent;
  /** Icoon rechts van de tekst. `null` voor geen icoon. */
  icon?: IconName | null;
  /** Tweede icoon, zichtbaar zolang de knop aria-expanded="true" heeft (bijv. menu ↔ close). */
  iconExpanded?: IconName;
  /** Toon op mobiel (≤767px) alleen het icoon, als vierkante knop. */
  iconOnlyOnMobile?: boolean;
  type?: "button" | "submit";
  /** Alleen de knopvorm, zonder eigen link of knop (binnen een element dat al klikbaar is) */
  as?: "span";
  target?: "_blank";
  class?: string;
  /** Extra attributen, bijv. aria-expanded of data-*. */
  attrs?: HTMLAttributes<"a"> &
    HTMLAttributes<"button"> &
    Record<`data-${string}`, string>;
}

const {
  label,
  href,
  variant = "primary",
  size = "default",
  accent,
  icon = "arrow-right",
  iconExpanded,
  iconOnlyOnMobile = false,
  type = "button",
  as,
  target,
  class: className,
  attrs = {},
} = Astro.props;

const Tag = as ?? (href ? "a" : "button");
const linkAttrs = as
  ? {}
  : href
  ? {
      href,
      target,
      rel: target === "_blank" ? "noopener noreferrer" : undefined,
    }
  : { type };
const sweepDown = icon === "arrow-down";
const iconMotion =
  icon === "arrow-down" ? "down" : icon === "arrow-right" ? "right" : undefined;
---

<Tag
  class:list={[
    "button",
    `button--${variant}`,
    `button--${size}`,
    {
      "button--sweep-down": sweepDown,
      "button--icon-only-mobile": iconOnlyOnMobile,
    },
    className,
  ]}
  data-accent={accent}
  aria-label={iconOnlyOnMobile ? label : undefined}
  {...linkAttrs}
  {...attrs}
>
  <span class="button__label">{label}</span>
  {
    icon && (
      <Icon
        name={icon}
        class:list={[
          "button__icon",
          iconMotion && `button__icon--${iconMotion}`,
          iconExpanded && "button__icon--collapsed",
        ]}
      />
    )
  }
  {
    iconExpanded && (
      <Icon name={iconExpanded} class="button__icon button__icon--expanded" />
    )
  }
</Tag>

<style>
  .button {
    --button-fill: var(--color-black);
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-8);
    height: var(--button-height);
    padding: var(--space-12) var(--button-padding-x);
    border: var(--border-width-thick) solid transparent;
    border-radius: var(--radius-none);
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: var(--fw-extra-bold);
    line-height: var(--lh-ui);
    letter-spacing: var(--ls-button);
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    /* Veeg: effen vulling die bij hover van links naar rechts (of boven naar onder) inloopt */
    background-image: linear-gradient(var(--button-fill), var(--button-fill));
    background-repeat: no-repeat;
    background-position: left;
    background-size: 0% 100%;
    transition:
      background-size var(--duration-base) var(--ease-reveal),
      color var(--duration-base) var(--ease-reveal),
      border-color var(--duration-base) var(--ease-reveal);
    cursor: var(--cursor-pointer);
  }

  .button--sweep-down {
    background-position: top;
    background-size: 100% 0%;
  }

  .button:hover,
  .button:focus-visible {
    background-size: 100% 100%;
  }

  .button :global(.button__icon) {
    --icon-size: var(--icon-md);
    transition: all var(--duration-fast) ease-in-out;
  }

  .button:hover :global(.button__icon--right) {
    transform: translateX(2px);
  }

  .button:hover :global(.button__icon--down) {
    transform: translateY(2px);
  }

  /* ─── Varianten ─── */
  .button--primary {
    --button-fill: var(--color-black);
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--color-black);
  }

  .button--primary:hover,
  .button--primary:focus-visible {
    color: var(--accent);
  }

  .button--outline {
    --button-fill: var(--accent);
    background-color: var(--color-black-a48);
    border-color: var(--accent);
    color: var(--accent);
    -webkit-backdrop-filter: blur(var(--blur-sm));
    backdrop-filter: blur(var(--blur-sm));
  }

  .button--ghost {
    --button-fill: var(--color-white);
    background-color: var(--color-black-a48);
    border-color: var(--color-gray-dark);
    color: var(--color-white);
    -webkit-backdrop-filter: blur(var(--blur-sm));
    backdrop-filter: blur(var(--blur-sm));
  }

  .button--outline:hover,
  .button--outline:focus-visible,
  .button--ghost:hover,
  .button--ghost:focus-visible {
    color: var(--color-black);
  }

  .button--ghost:hover,
  .button--ghost:focus-visible {
    border-color: var(--color-white);
  }

  .button :global(.button__icon--expanded),
  .button[aria-expanded="true"] :global(.button__icon--collapsed) {
    display: none;
  }

  .button[aria-expanded="true"] :global(.button__icon--expanded) {
    display: inline-block;
  }

  /* ─── Groottes ─── */
  /* compact: Webflow .menu-open (menuknop) */
  .button--compact {
    gap: var(--space-10);
    height: var(--button-height-small);
    padding-inline: var(--space-16);
  }

  .button--compact :global(.button__icon) {
    --icon-size: var(--icon-sm);
  }

  @media (min-width: 1920px) {
    .button--compact {
      padding-inline: var(--space-24);
    }
  }

  .button--small {
    height: var(--button-height-small);
    padding-inline: var(--button-padding-x-small);
  }

  .button--large {
    height: var(--button-height-large);
    padding: var(--space-16) var(--button-padding-x-large);
  }

  @media (max-width: 767px) {
    .button--icon-only-mobile {
      width: var(--button-height-small);
      padding: 0;
    }

    .button--icon-only-mobile .button__label {
      display: none;
    }

    .button--icon-only-mobile :global(.button__icon) {
      --icon-size: var(--icon-lg);
    }
  }
</style>
