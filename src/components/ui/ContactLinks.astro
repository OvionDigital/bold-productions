---
/**
 * Lijst contactlinks (bellen, mailen, WhatsApp) met icoon in de linkkleur en witte tekst,
 * zoals live (Webflow .contact-link-block). Icoon volgt het soort link (tel:, mailto:, anders WhatsApp).
 * Gebruikt door ContactSection en TextMedia ("Mail Mike").
 */
import Icon from './Icon.astro';
import type { IconName } from './icons';

export interface ContactLink {
  label: string;
  href: string;
}

interface Props {
  links: ContactLink[];
  class?: string;
}

const { links, class: className } = Astro.props;

const iconFor = (href: string): IconName =>
  href.startsWith('tel:') ? 'phone' : href.startsWith('mailto:') ? 'mail' : 'whatsapp-outline';
const isExternal = (href: string) => href.startsWith('http');
---

<ul class:list={['contact-links', className]} role="list">
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          class="contact-links__link"
          target={isExternal(link.href) ? '_blank' : undefined}
          rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
        >
          <Icon name={iconFor(link.href)} size="var(--icon-lg)" />
          <span class="contact-links__text">{link.label}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .contact-links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Icoon in de linkkleur (groen), tekst wit — zoals live */
  .contact-links__link {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: var(--space-12);
    padding-block: var(--space-8);
    text-decoration: none;
  }

  .contact-links__text {
    color: var(--color-white);
  }
</style>
