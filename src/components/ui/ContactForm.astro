---
/**
 * Formulier (Webflow wf-form-Contact / wf-form-Offerte): velden uit de data, verzendknop,
 * succes- en foutmelding. Verzenden via fetch (scripts/contact-form.ts) naar `action`.
 * Honeypot-veld tegen spam (geen reCAPTCHA). Veldnamen gelijk aan het Webflow-formulier.
 *
 * Veldtypes: tekstvelden (optioneel met `hint`), `heading` (tussenkop), `radio` (keuzerondjes),
 * `select` (keuzelijst, één keuze) en `checkboxes` (meerkeuze-dropdown; <details>, tekst
 * bijgewerkt door scripts/multiselect.ts; opties eventueel in groepen, `required` = minstens één).
 * `other` bij radio/select/checkboxes: tekstveld dat verschijnt bij de keuze "Anders"
 * (gedrag: scripts/contact-form.ts).
 * `labelSpacing: 'all'` = elk label 12px ruimte (Webflow .form-label), anders alleen
 * het eerste (zoals het contactformulier live).
 *
 * Verborgen velden `_formulier` (naam), `_pagina` (pad) en `_kop` (per tussenkop) gaan mee
 * naar de backend (functions/api/form.ts) voor het onderwerp en de indeling van de mail.
 */
import Button from './Button.astro';
import RichText from './RichText.astro';
import type { Rich } from '../../lib/rich';

export interface ContactFormInput {
  name: string;
  label: string;
  type: 'text' | 'email' | 'tel' | 'textarea';
  placeholder: string;
  required?: boolean;
  maxlength?: number;
  autocomplete?: string;
  /** Hulptekst onder het label */
  hint?: string;
}

/** Tekstveld dat verschijnt bij de keuze `value` (standaard "Anders") */
export interface ContactFormOther {
  name: string;
  label: string;
  placeholder: string;
  value?: string;
}

/** Optie, of een groep opties onder een kopje (niet zelf aan te vinken) */
export type ContactFormOption = string | { group: string; options: string[] };

export type ContactFormField =
  | ContactFormInput
  | { type: 'heading'; label: string }
  | { type: 'radio'; name: string; label: string; options: string[]; required?: boolean; other?: ContactFormOther }
  | { type: 'select'; name: string; label: string; placeholder: string; options: string[]; required?: boolean; other?: ContactFormOther }
  | {
      type: 'checkboxes';
      name: string;
      label: string;
      placeholder: string;
      /** Tekst bij meerdere keuzes, {n} = aantal (bijv. '{n} diensten geselecteerd') */
      countLabel: string;
      options: ContactFormOption[];
      /** Minstens één keuze */
      required?: boolean;
      other?: ContactFormOther;
    };

export interface ContactFormProps {
  name: string;
  /** Endpoint voor POST (FormData). Leeg = nog niet gekoppeld. */
  action?: string;
  fields: ContactFormField[];
  optionalLabel: string;
  submitLabel: string;
  submittingLabel: string;
  success: { title: string; text: Rich };
  error: string;
  labelSpacing?: 'first' | 'all';
}

type Props = ContactFormProps;

const { name, action, fields, optionalLabel, submitLabel, submittingLabel, success, error, labelSpacing = 'first' } = Astro.props;
const slug = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const formId = `form-${slug(name)}`;
const page = Astro.url.pathname.replace(/\.html$/, '');
---

<div class:list={['contact-form', `contact-form--labels-${labelSpacing}`]} data-contact-form>
  <form
    id={formId}
    name={name}
    method="post"
    action={action || undefined}
    class="contact-form__form"
    data-contact-form-form
    data-submitting-label={submittingLabel}
  >
    {
      fields.map((field, index) => {
        if (field.type === 'heading') {
          // `_kop`: dezelfde tussenkop in de mail
          return (
            <>
              <h3 class:list={['contact-form__heading', { 'contact-form__heading--first': index === 0 }]}>{field.label}</h3>
              <input type="hidden" name="_kop" value={field.label} />
            </>
          );
        }
        const fieldId = `${formId}-${slug(field.name)}`;
        const optional = !field.required && optionalLabel && <span class="contact-form__optional"> {optionalLabel}</span>;
        const other = 'other' in field && field.other && (
          <div class="contact-form__field" hidden data-form-other={field.name} data-form-other-value={field.other.value ?? 'Anders'}>
            <label for={`${fieldId}-other`} class="contact-form__label">
              {field.other.label}
            </label>
            <input id={`${fieldId}-other`} name={field.other.name} type="text" placeholder={field.other.placeholder} maxlength="256" disabled class="contact-form__input" />
          </div>
        );
        if (field.type === 'radio') {
          return (
            <>
              <fieldset class="contact-form__field contact-form__field--radio">
                <legend class="contact-form__label contact-form__label--radio">
                  {field.label}
                  {optional}
                </legend>
                {field.options.map((option) => (
                  <label class="contact-form__choice">
                    <input type="radio" name={field.name} value={option} required={field.required} class="contact-form__choice-input" />
                    <span class="contact-form__choice-box contact-form__choice-box--radio" aria-hidden="true" />
                    <span>{option}</span>
                  </label>
                ))}
              </fieldset>
              {other}
            </>
          );
        }
        if (field.type === 'select') {
          return (
            <>
              <div class="contact-form__field">
                <label for={fieldId} class="contact-form__label">
                  {field.label}
                  {optional}
                </label>
                <select id={fieldId} name={field.name} required={field.required} class="contact-form__input contact-form__input--select">
                  <option value="" disabled selected>
                    {field.placeholder}
                  </option>
                  {field.options.map((option) => (
                    <option value={option}>{option}</option>
                  ))}
                </select>
              </div>
              {other}
            </>
          );
        }
        if (field.type === 'checkboxes') {
          const checkbox = (option: string) => (
            <label class="contact-form__choice contact-form__choice--option">
              <input type="checkbox" name={field.name} value={option} class="contact-form__choice-input" />
              <span class="contact-form__choice-box" aria-hidden="true" />
              <span>{option}</span>
            </label>
          );
          return (
            <>
              <div class="contact-form__field">
                <span class="contact-form__label" id={`${fieldId}-label`}>
                  {field.label}
                </span>
                <details class="contact-form__multi" data-multiselect data-multiselect-required={field.required ? '' : undefined}>
                  <summary class="contact-form__multi-trigger" aria-describedby={`${fieldId}-label`} data-multiselect-summary data-placeholder={field.placeholder} data-count-label={field.countLabel}>
                    {field.placeholder}
                  </summary>
                  <div class="contact-form__multi-panel" role="group" aria-labelledby={`${fieldId}-label`} data-lenis-prevent>
                    {field.options.map((option, groupIndex) =>
                      typeof option === 'string' ? (
                        checkbox(option)
                      ) : (
                        <div class="contact-form__multi-group" role="group" aria-labelledby={`${fieldId}-group-${groupIndex}`}>
                          <span class="contact-form__multi-group-label" id={`${fieldId}-group-${groupIndex}`}>
                            {option.group}
                          </span>
                          {option.options.map(checkbox)}
                        </div>
                      ),
                    )}
                  </div>
                </details>
              </div>
              {other}
            </>
          );
        }
        const hintId = field.hint ? `${fieldId}-hint` : undefined;
        return (
          <div class="contact-form__field">
            <label for={fieldId} class="contact-form__label">
              {field.label}
              {optional}
            </label>
            {field.hint && (
              <p class="contact-form__hint" id={hintId}>
                {field.hint}
              </p>
            )}
            {field.type === 'textarea' ? (
              <textarea
                id={fieldId}
                name={field.name}
                placeholder={field.placeholder}
                required={field.required}
                maxlength={field.maxlength}
                aria-describedby={hintId}
                rows="2"
                class="contact-form__input contact-form__input--textarea"
              />
            ) : (
              <input
                id={fieldId}
                name={field.name}
                type={field.type}
                placeholder={field.placeholder}
                required={field.required}
                maxlength={field.maxlength}
                autocomplete={field.autocomplete}
                aria-describedby={hintId}
                class="contact-form__input"
              />
            )}
          </div>
        );
      })
    }
    <input type="hidden" name="_formulier" value={name} />
    <input type="hidden" name="_pagina" value={page} />
    <div class="contact-form__honeypot" aria-hidden="true">
      <label for={`${formId}-website`}>Website</label>
      <input id={`${formId}-website`} type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>
    <Button label={submitLabel} type="submit" icon={null} attrs={{ 'data-contact-form-submit': '' }} />
  </form>

  <div class="contact-form__success" role="status" hidden data-contact-form-success>
    <h2 class="contact-form__success-title">{success.title}</h2>
    <RichText content={success.text} plain class="contact-form__success-text" />
  </div>

  <div class="contact-form__error" role="alert" hidden data-contact-form-error>
    {error}
  </div>
</div>

<style>
  /* Webflow .w-form: 15px ondermarge (telt mee bij het centreren in de rij) */
  .contact-form {
    margin-bottom: var(--space-15);
  }

  .contact-form__label {
    display: block;
    margin-bottom: var(--space-5);
    font-size: var(--fs-label);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
  }

  /* Zoals live: alleen het eerste label heeft 12px ruimte (Webflow .form-label) */
  .contact-form__field:first-child .contact-form__label {
    margin-bottom: var(--space-12);
  }

  .contact-form--labels-all .contact-form__label {
    margin-bottom: var(--space-12);
  }

  /* Webflow .form-label.extra-margin: label direct na een groep keuzerondjes */
  .contact-form__field--radio + .contact-form__field .contact-form__label,
  .contact-form__field--radio + [hidden] + .contact-form__field .contact-form__label {
    margin-top: var(--space-24);
  }

  .contact-form__field--radio + .contact-form__field--radio {
    margin-top: var(--space-24);
  }

  .contact-form__heading {
    display: inline-block;
    margin: var(--space-48) 0 0.75em;
    color: var(--accent);
  }

  .contact-form__heading--first {
    margin-top: 0;
  }

  .contact-form__field--radio {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .contact-form--labels-all .contact-form__label--radio {
    margin-bottom: var(--space-4);
    padding: 0;
  }

  .contact-form__choice {
    position: relative;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: var(--space-8);
    margin-bottom: var(--space-5);
    padding: var(--space-4) var(--space-15);
  }

  .contact-form__choice--option {
    gap: var(--space-10);
    padding: var(--space-8) var(--space-15);
  }

  .contact-form__choice-input {
    position: absolute;
    z-index: var(--z-below);
    opacity: 0;
  }

  /* Webflow .form-checkbox: vakje van 16px, oranje gevuld als het aangevinkt is */
  .contact-form__choice-box {
    flex: none;
    width: var(--icon-sm);
    height: var(--icon-sm);
    border: var(--border-width) solid var(--color-gray-light);
    border-radius: var(--radius-sm);
  }

  .contact-form__choice-box--radio {
    border-radius: var(--radius-round);
  }

  .contact-form__choice-input:checked + .contact-form__choice-box {
    border-color: var(--color-orange);
    background-color: var(--color-orange);
  }

  .contact-form__choice-input:focus-visible + .contact-form__choice-box {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .contact-form__multi {
    position: relative;
    width: 100%;
    margin-bottom: var(--space-32);
  }

  .contact-form__multi-trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-16) var(--space-24);
    background-color: var(--color-gray-dark);
    font-size: var(--fs-base);
    list-style: none;
  }

  .contact-form__multi-trigger::-webkit-details-marker {
    display: none;
  }

  .contact-form__multi-trigger::after {
    content: '\25BE';
    margin-left: var(--space-8);
    color: var(--color-gray);
  }

  .contact-form__multi-panel {
    position: absolute;
    top: calc(100% + var(--space-4));
    left: 0;
    z-index: var(--z-menu-overlay);
    width: 100%;
    padding: var(--space-8) var(--space-16);
    border: var(--border-width) solid var(--color-gray-dark);
    background-color: var(--color-black-a48);
    -webkit-backdrop-filter: blur(var(--blur-md));
    backdrop-filter: blur(var(--blur-md));
  }

  /* Lange lijsten: het paneel scrollt zelf (data-lenis-prevent) */
  .contact-form__multi-panel {
    max-height: var(--multiselect-max-height);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .contact-form__multi-group + .contact-form__multi-group,
  .contact-form__multi-group + .contact-form__choice {
    margin-top: var(--space-12);
  }

  /* Groepskop zoals in het menupaneel: Gate, kapitalen, accentkleur */
  .contact-form__multi-group-label {
    display: block;
    padding: var(--space-8) var(--space-15) var(--space-4);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: var(--fs-md);
    line-height: var(--lh-ui);
    text-transform: uppercase;
  }

  .contact-form__hint {
    margin: calc(var(--space-4) - var(--space-12)) 0 var(--space-12);
    color: var(--color-gray-light);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }

  .contact-form__optional {
    color: var(--color-gray-light);
    font-style: italic;
  }

  .contact-form__input {
    display: block;
    width: 100%;
    height: var(--button-height);
    margin-bottom: var(--space-32);
    padding: var(--space-16) calc(var(--space-48) + var(--space-4)) var(--space-16) var(--space-24);
    border: 0;
    border-radius: 0;
    background-color: var(--color-gray-dark);
    color: var(--color-white);
    font-size: var(--fs-base);
    line-height: var(--lh-relaxed);
  }

  .contact-form__input::placeholder {
    color: var(--color-placeholder);
  }

  .contact-form__input--select {
    padding-right: var(--space-48);
    background-image: var(--select-arrow);
    background-position: right var(--space-24) center;
    background-repeat: no-repeat;
    background-size: var(--space-10);
    font-family: inherit;
    appearance: none;
  }

  /* Nog niets gekozen: kleur van een placeholder */
  .contact-form__input--select:invalid {
    color: var(--color-placeholder);
  }

  .contact-form__input--select option {
    background-color: var(--color-gray-dark);
    color: var(--color-white);
  }

  .contact-form__input--textarea {
    height: auto;
    resize: vertical;
  }

  .contact-form__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-form__success {
    padding: var(--space-20);
    background-color: var(--color-green);
    color: var(--color-black);
  }

  .contact-form__success-title {
    display: block;
    color: var(--color-black);
  }

  .contact-form__success :global(a) {
    color: var(--color-black);
  }

  .contact-form__error {
    margin-top: var(--space-10);
    padding: var(--space-10);
    background-color: var(--color-error-bg);
    color: var(--color-black);
  }
</style>
