---
/**
 * Foto in polaroidlijst: witte rand (12px, onder 24px), diepe schaduw, optioneel
 * een caption in typemachineletter. Kanteling via --polaroid-rotate.
 */
import type { ImageMetadata } from 'astro';
import CmsPicture from './CmsPicture.astro';
import type { RemoteImage } from '../../lib/sanity/image';

export interface PolaroidPhoto {
  src: ImageMetadata | RemoteImage;
  alt: string;
  caption?: string;
}

interface Props extends PolaroidPhoto {
  sizes?: string;
  class?: string;
}

const { src, alt, caption, sizes = '(max-width: 991px) 100vw, 900px', class: className } = Astro.props;
---

<figure class:list={['polaroid', className]}>
  <CmsPicture
    src={src}
    alt={alt}
    widths={[480, 720, 960, 1280, 1700]}
    sizes={sizes}
    loading="lazy"
    decoding="async"
    class="polaroid__image"
  />
  {caption && <figcaption class="polaroid__caption">{caption}</figcaption>}
</figure>

<style>
  .polaroid {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    height: 100%;
    margin: 0;
    background: var(--color-white);
    box-shadow: var(--shadow-polaroid);
    transform: rotate(var(--polaroid-rotate, 0deg));
  }

  .polaroid :global(picture) {
    display: block;
    width: 100%;
  }

  .polaroid :global(.polaroid__image) {
    display: block;
    width: 100%;
    height: 100%;
    padding: var(--space-12) var(--space-12) var(--space-24);
    object-fit: cover;
  }

  .polaroid__caption {
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-caption);
    text-align: center;
  }
</style>
