---
/**
 * Kleine kop in spatiëring boven een titel (Webflow: .subtitle),
 * bijv. "Ervoor. Tijdens. Erna" of "Vertrouwd door". Regeleinden met '
'.
 */
import { toLines } from '../../lib/text';
interface Props {
  text: string;
  as?: 'p' | 'span' | 'h2' | 'h3' | 'div';
  align?: 'start' | 'center';
  class?: string;
}

const { text, as: Tag = 'p', align = 'start', class: className } = Astro.props;
---

<Tag class:list={['eyebrow', `eyebrow--${align}`, className]}>{toLines(text).map((line, i) => (i > 0 ? [<br />, line] : line))}</Tag>

<style>
  .eyebrow {
    display: inline-block;
    flex: none;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-subtitle);
    font-weight: var(--fw-display);
    line-height: var(--lh-relaxed);
    letter-spacing: var(--ls-subtitle);
    text-transform: uppercase;
    overflow-wrap: break-word;
  }

  .eyebrow--center {
    text-align: center;
  }
</style>
