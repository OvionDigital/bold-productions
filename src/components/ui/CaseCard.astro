---
/**
 * Casekaart (Webflow .work-overview-item): foto (3:2, ≤991 16:9, zoals live) met donkere
 * diagonale gradient, titel in groene gradient en intro (vanaf 1280px).
 * Hele kaart is een link naar /cases/[slug].
 * `tags`: labels onderaan (doelgroep + diensten), zoals in het casesoverzicht
 * (Webflow .work-overview-item.overview: ≤767 vierkant).
 */
import Heading from './Heading.astro';
import CmsPicture from './CmsPicture.astro';
import { caseUrl, type Case } from '../../data/cases';

interface Props {
  item: Case;
  tags?: string[];
  sizes?: string;
  class?: string;
}

const { item, tags, sizes = '(max-width: 991px) 100vw, (max-width: 1439px) 67vw, 50vw', class: className } = Astro.props;
---

<a href={caseUrl(item.slug)} class:list={['case-card', { 'case-card--tagged': tags?.length }, className]}>
  <span class="case-card__shade" aria-hidden="true"></span>
  <CmsPicture
    src={item.image.src}
    alt={item.image.alt}
    widths={[480, 720, 960, 1280, 1600]}
    sizes={sizes}
    formats={['avif', 'webp']}
    loading="lazy"
    decoding="async"
    class="case-card__image"
  />
  <span class="case-card__content">
    <Heading as="h3" text={item.title} gradient="green" flush class="case-card__title" />
    <span class="case-card__intro">{item.intro}</span>
    {
      tags?.length ? (
        <span class="case-card__tags">
          {tags.map((tag) => (
            <span class="case-card__tag">{tag}</span>
          ))}
        </span>
      ) : null
    }
  </span>
</a>

<style>
  .case-card {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    text-decoration: none;
    transition:
      box-shadow var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .case-card:hover {
    transform: scale(1.03);
    box-shadow: var(--shadow-card-hover);
  }

  .case-card__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image: linear-gradient(-135deg, var(--color-transparent), var(--color-black));
  }

  .case-card :global(picture) {
    position: absolute;
    inset: 0;
  }

  .case-card :global(.case-card__image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-card__content {
    position: absolute;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    padding: var(--space-32);
  }

  .case-card__content :global(.case-card__title) {
    text-align: left;
  }

  .case-card__intro {
    display: none;
    margin-bottom: 0;
    color: var(--color-white);
    line-height: var(--lh-paragraph);
  }

  .case-card__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: center;
    gap: var(--space-8);
  }

  /* Webflow .work-overview-tag */
  .case-card__tag {
    padding: var(--space-4) var(--space-12);
    border: var(--border-width) solid var(--color-white-a10);
    background-color: var(--color-white-a6);
    -webkit-backdrop-filter: blur(var(--blur-md));
    backdrop-filter: blur(var(--blur-md));
    color: var(--color-white);
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
  }

  @media (min-width: 1280px) {
    .case-card__intro {
      display: block;
    }

    .case-card__tag {
      padding: var(--space-8) var(--space-20);
      font-size: var(--fs-base);
    }
  }

  @media (max-width: 991px) {
    .case-card {
      aspect-ratio: 16 / 9;
    }

    .case-card--tagged {
      aspect-ratio: 3 / 2;
    }
  }

  @media (max-width: 767px) {
    .case-card--tagged {
      aspect-ratio: 1;
    }
  }

  @media (max-width: 767px) {
    .case-card__content {
      gap: var(--space-16);
      padding: var(--space-36);
    }
  }

  @media (max-width: 479px) {
    .case-card__content {
      padding: var(--space-24);
    }

    .case-card__tag {
      padding: var(--space-4) var(--space-12);
    }

    .case-card__intro {
      display: none;
    }
  }
</style>
