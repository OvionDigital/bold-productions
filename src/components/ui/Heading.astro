---
/**
 * Displaykop in Gate. Semantisch niveau (`as`) staat los van de visuele grootte (`size`).
 * hero en h1: kapitalen met merkgradient (`gradient`). h2–h6: kapitalen in effen kleur
 * (rustig & effen): h2 in de kleur van `gradient`, h3 wit, h4–h6 kleine labels.
 * Regeleinden: gebruik '\n' in `text`.
 */
import { toLines } from '../../lib/text';

export type HeadingSize = 'hero' | 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
export type HeadingGradient = 'orange' | 'yellow' | 'green' | 'accent' | 'none';

interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'p';
  size?: HeadingSize;
  gradient?: HeadingGradient;
  align?: 'start' | 'center';
  /** Verwijder de standaard marges (Webflow: .mb-0 / .section-h2) */
  flush?: boolean;
  class?: string;
}

const {
  text,
  as: Tag = 'h2',
  size = Tag === 'p' ? 'h2' : Tag,
  gradient = 'none',
  align = 'start',
  flush = false,
  class: className,
} = Astro.props;
const lines = toLines(text);
/** hero en h1 houden de kapitalen met gradient */
const isDisplay = size === 'hero' || size === 'h1';
---

<Tag
  class:list={[
    'heading',
    `heading--${size}`,
    `heading--${align}`,
    { 'heading--flush': flush, 'text-gradient': gradient !== 'none' },
    gradient !== 'none' && gradient !== 'accent' && `text-gradient--${gradient}`,
    !isDisplay && `heading--tone-${gradient}`,
    className,
  ]}
>
  {lines.map((line, i) => (i < lines.length - 1 ? <Fragment>{line}<br /></Fragment> : line))}
</Tag>

<style>
  .heading {
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    text-transform: uppercase;
    letter-spacing: var(--ls-heading);
    overflow-wrap: break-word;
    -webkit-hyphens: auto;
    hyphens: auto;
  }

  .heading--hero {
    font-size: var(--fs-hero);
    line-height: var(--lh-display);
    text-wrap: pretty;
    margin: 0;
  }

  .heading--h1 {
    font-size: var(--fs-h1);
    line-height: var(--lh-display);
  }

  /*
   * h2–h6 "rustig & effen": kapitalen met lucht (regelafstand 100%), effen kleur i.p.v.
   * gradient. h2 in de kleur van `gradient` (none/accent = accentkleur), h3 wit,
   * h4–h6 kleine gespatieerde labels: h4 in de kleur, h5–h6 lichtgrijs.
   */
  .heading--h2,
  .heading--h3,
  .heading--h4,
  .heading--h5,
  .heading--h6 {
    --heading-tone: var(--accent);
    line-height: var(--lh-none);
    background-image: none;
    -webkit-text-fill-color: currentColor;
  }

  .heading--tone-orange {
    --heading-tone: var(--color-orange);
  }

  .heading--tone-yellow {
    --heading-tone: var(--color-yellow);
  }

  .heading--tone-green {
    --heading-tone: var(--color-green);
  }

  .heading--h2 {
    font-size: var(--fs-h2);
    display: inline-block;
    color: var(--heading-tone);
  }

  .heading--h3 {
    font-size: var(--fs-h3);
    color: var(--color-white);
  }

  .heading--h4,
  .heading--h5,
  .heading--h6 {
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
    letter-spacing: var(--ls-label);
  }

  .heading--h4 {
    color: var(--heading-tone);
  }

  .heading--h5,
  .heading--h6 {
    color: var(--color-gray-light);
  }

  .heading--center {
    text-align: center;
  }

  .heading--flush {
    margin-top: 0;
    margin-bottom: 0;
  }
</style>
