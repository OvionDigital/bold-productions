---
/**
 * Vimeo-video met vaste verhouding (geen player.js).
 *
 * Met bediening (`background={false}`): een "gevel" — alleen een thumbnail met
 * afspeelknop; de echte speler (± 450 kB JavaScript en cookies van Vimeo) laadt pas bij
 * een klik en start dan meteen (scripts/vimeo-facade.ts). Zonder JS: link naar Vimeo.
 * Thumbnail uit oEmbed (src/lib/vimeo.ts); de VideoObject-structured data (cases) maakt
 * lib/structured-data.ts.
 *
 * `background` (standaard): decoratief, automatisch, gedempt en herhalend (Vimeo
 * background=1), lazy iframe, vullend bijgesneden op de eigen verhouding van de video (oEmbed),
 * zodat er geen zwarte balken komen als die afwijkt van het kader. Altijd met dnt=1: Vimeo
 * plaatst geen tracking-cookies.
 *
 * `ratio`: vaste verhouding of een getal (hoogte / breedte, bijv. 0.5625 = 16:9).
 */
import Icon from './Icon.astro';
import { getVimeoMeta, thumbnailAt } from '../../lib/vimeo';

interface Props {
  id: string;
  hash?: string;
  title: string;
  ratio?: 'square' | 'portrait' | 'landscape' | number;
  background?: boolean;
  class?: string;
}

const { id, hash, title, ratio = 'square', background = true, class: className } = Astro.props;
const params = new URLSearchParams({
  ...(hash ? { h: hash } : {}),
  dnt: '1',
  ...(background ? { autoplay: '1', loop: '1', muted: '1', background: '1' } : { autoplay: '1' }),
});
const src = `https://player.vimeo.com/video/${id}?${params.toString()}`;
const meta = await getVimeoMeta(id, hash);
const videoRatio = meta?.width && meta.height ? meta.width / meta.height : undefined;
const watchUrl = `https://vimeo.com/${id}${hash ? `/${hash}` : ''}`;
const thumbWidths = [480, 640, 960, 1280];
---

<div
  class:list={['vimeo-embed', typeof ratio === 'string' && `vimeo-embed--${ratio}`, background && videoRatio && 'vimeo-embed--cover', className]}
  style={[typeof ratio === 'number' && `aspect-ratio: 1 / ${ratio}`, background && videoRatio && `--video-ratio: ${videoRatio}`].filter(Boolean).join('; ') || undefined}
>
  {
    background ? (
      <iframe
        src={src}
        title={title}
        loading="lazy"
        allow="autoplay; fullscreen; picture-in-picture"
        referrerpolicy="strict-origin-when-cross-origin"
        tabindex="-1"
        class="vimeo-embed__iframe vimeo-embed__iframe--background"
      />
    ) : (
      <a href={watchUrl} class="vimeo-embed__facade" data-vimeo-facade={src} data-title={title} target="_blank" rel="noopener">
        {meta?.thumbnail && (
          <img
            src={thumbnailAt(meta.thumbnail, 960)}
            srcset={thumbWidths.map((w) => `${thumbnailAt(meta.thumbnail, w)} ${w}w`).join(', ')}
            sizes="(max-width: 991px) 100vw, 1140px"
            alt=""
            loading="lazy"
            decoding="async"
            class="vimeo-embed__thumb"
          />
        )}
        <span class="vimeo-embed__play" aria-hidden="true">
          <Icon name="play" />
        </span>
        <span class="visually-hidden">Video afspelen: {title}</span>
      </a>
    )
  }
</div>

<style>
  .vimeo-embed {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--color-black);
  }

  .vimeo-embed--square {
    aspect-ratio: 1;
  }

  .vimeo-embed--portrait {
    aspect-ratio: 9 / 16;
  }

  .vimeo-embed--landscape {
    aspect-ratio: 16 / 9;
  }

  .vimeo-embed :global(.vimeo-embed__iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .vimeo-embed__iframe--background {
    pointer-events: none;
  }

  .vimeo-embed__facade {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--color-black);
    cursor: var(--cursor-pointer);
  }

  .vimeo-embed__thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-reveal);
  }

  .vimeo-embed__facade:hover .vimeo-embed__thumb {
    transform: scale(1.03);
  }

  /* Lichte waas zodat de knop op elke thumbnail leesbaar is */
  .vimeo-embed__facade::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, var(--color-black-a40), var(--color-transparent) 60%);
    pointer-events: none;
  }

  /* Afspeelknop: glazen ring met witte driehoek; bij hover vult de ring zich vanuit het
     midden met de accentkleur en wordt de driehoek zwart. Een rustige puls trekt de aandacht. */
  .vimeo-embed__play {
    position: relative;
    z-index: var(--z-base);
    display: flex;
    justify-content: center;
    align-items: center;
    width: var(--video-play-size);
    height: var(--video-play-size);
    border: var(--border-width-thick) solid var(--color-white-a70);
    border-radius: var(--radius-round);
    background-color: var(--color-black-a40);
    -webkit-backdrop-filter: blur(var(--blur-md));
    backdrop-filter: blur(var(--blur-md));
    color: var(--color-white);
    transition:
      border-color var(--duration-base) var(--ease-reveal),
      color var(--duration-base) var(--ease-reveal);
  }

  .vimeo-embed__play::before,
  .vimeo-embed__play::after {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--border-width-thick));
    border-radius: inherit;
    pointer-events: none;
  }

  .vimeo-embed__play::before {
    z-index: var(--z-below);
    background-color: var(--accent);
    opacity: 0;
    scale: 0.4;
    transition:
      opacity var(--duration-base) var(--ease-reveal),
      scale var(--duration-base) var(--ease-reveal);
  }

  .vimeo-embed__play::after {
    border: var(--border-width-thick) solid var(--accent);
    opacity: 0;
  }

  .vimeo-embed__play :global(.icon) {
    --icon-size: var(--icon-xl);
    margin-right: var(--space-4); /* optisch midden van de driehoek */
  }

  .vimeo-embed__facade:hover .vimeo-embed__play,
  .vimeo-embed__facade:focus-visible .vimeo-embed__play {
    border-color: var(--accent);
    color: var(--color-black);
  }

  .vimeo-embed__facade:hover .vimeo-embed__play::before,
  .vimeo-embed__facade:focus-visible .vimeo-embed__play::before {
    opacity: 1;
    scale: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .vimeo-embed__play::after {
      animation: play-pulse var(--duration-pulse) var(--ease-reveal) infinite;
    }

    .vimeo-embed__facade:hover .vimeo-embed__play::after {
      animation: none;
    }
  }

  @keyframes play-pulse {
    0% {
      opacity: 0.8;
      scale: 1;
    }

    40%,
    100% {
      opacity: 0;
      scale: 1.5;
    }
  }

  /* Achtergrondvideo vullend (zoals object-fit: cover) op de eigen verhouding --video-ratio */
  .vimeo-embed--cover {
    container-type: size;
  }

  .vimeo-embed--cover :global(.vimeo-embed__iframe) {
    top: 50%;
    left: 50%;
    width: max(100cqw, 100cqh * var(--video-ratio));
    max-width: none;
    height: max(100cqh, 100cqw / var(--video-ratio));
    translate: -50% -50%;
  }
</style>
