---
/**
 * Vaste navigatiebalk: logo, desktop-dropdowns (≥1280px), CTA en menuknop.
 * De menuknop opent MenuPanel (gedrag in scripts/menu.ts).
 * Verbergt bij scrollen naar beneden, verschijnt weer bij scrollen naar boven
 * (scripts/navbar-autohide.ts). Blijft staan bovenaan de pagina, met open menu,
 * of bij focus erin (toetsenbord); uit bij ?static=1 en reduced motion.
 * Neutrale pagina's: geen menu, alleen `buttons` (Bold Events / Bold Business). `revealAfter`:
 * verborgen tot dat element voorbij is (homepage: de split-hero heeft zelf het logo en de keuze).
 */
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import MegaMenu from './MegaMenu.astro';
import MenuPanel from './MenuPanel.astro';
import type { NavButton, NavGroup, NavLink } from '../../data/navigation';
import logo from '../../assets/brand/bold-productions-logo.png';

interface Props {
  nav: NavGroup[];
  /** Leeg = geen knop (neutrale pagina's) */
  cta?: NavLink;
  /** Waar het logo naartoe linkt (homepage van dit deel van de site) */
  home?: string;
  /** Knoppen i.p.v. een menu (neutrale pagina's); met een leeg `nav` geen megamenu en geen menuknop */
  buttons?: NavButton[];
  /** CSS-selector: navbar pas tonen als dit element voorbij is (homepage: de split-hero) */
  revealAfter?: string;
  menuLabel: string;
  logoAlt: string;
  homeTitle: string;
  currentPath: string;
}

const { nav, cta, home = '/', buttons = [], revealAfter, menuLabel, logoAlt, homeTitle, currentPath } = Astro.props;
const hasMenu = nav.length > 0;
const isHome = currentPath === home;
---

<header class="navbar" data-navbar data-reveal-after={revealAfter}>
  <div class="navbar__inner">
    <div class="navbar__brand">
      <a href={home} title={homeTitle} aria-current={isHome ? 'page' : undefined} class="navbar__logo">
        <Picture
          src={logo}
          alt={logoAlt}
          widths={[124, 154, 248, 308]}
          sizes="(max-width: 767px) 124px, 154px"
          formats={['avif', 'webp']}
          loading="eager"
          class="navbar__logo-img"
        />
      </a>
    </div>

    {hasMenu && <MegaMenu groups={nav.filter((group) => group.inHeader)} currentPath={currentPath} />}

    <div class="navbar__actions">
      {cta && <Button label={cta.label} href={cta.href} size="small" class="navbar__cta" />}
      {
        buttons.map((button) => (
          <a href={button.href} class="navbar__choice-link" data-accent={button.accent}>
            <Button label={button.label} as="span" variant="outline" accent={button.accent} size="small" icon={null} class="navbar__choice navbar__choice--full" />
            {button.shortLabel && (
              <Button label={button.shortLabel} as="span" variant="outline" accent={button.accent} size="small" icon={null} class="navbar__choice navbar__choice--short" />
            )}
          </a>
        ))
      }
      {
        hasMenu && (
          <div class="navbar__menu">
            <Button
              label={menuLabel}
              variant="ghost"
              size="compact"
              icon="menu"
              iconExpanded="close"
              iconOnlyOnMobile
              class="navbar__toggle"
              attrs={{ 'aria-expanded': 'false', 'aria-controls': 'menu-panel', 'data-menu-toggle': '' }}
            />
            <MenuPanel id="menu-panel" groups={nav} cta={cta} currentPath={currentPath} />
          </div>
        )
      }
    </div>
  </div>
</header>

<style>
  .navbar {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-navbar);
    display: flex;
    justify-content: center;
    align-items: center;
    padding-block: var(--navbar-padding-y);
    background-image: var(--gradient-navbar);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .navbar.is-hidden {
    transform: translateY(-100%);
  }

  /* Homepage: verborgen tot de split-hero voorbij is (scripts/navbar-autohide.ts). Alleen met
     JS (klasse .js vóór de eerste paint), zodat de navbar zonder JS gewoon zichtbaar blijft. */
  :global(.js) .navbar[data-reveal-after]:not(.is-revealed):not(:has(:focus-visible)) {
    transform: translateY(-100%);
  }

  /* Toetsenbordfocus in de navbar (bijv. na Tab) maakt 'm altijd zichtbaar.
     Bewust :focus-visible i.p.v. :focus-within: na een muisklik houdt een knop
     de focus, en dan zou de navbar nooit meer verbergen. */
  .navbar:has(:focus-visible) {
    transform: none;
  }

  .navbar__inner {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding-inline: var(--container-padding-wide);
  }

  .navbar__brand {
    position: relative;
    z-index: var(--z-menu-controls);
    margin-right: auto;
  }

  .navbar__logo {
    display: inline-block;
    max-width: 100%;
  }

  .navbar__logo :global(img) {
    width: var(--logo-width);
    height: auto;
    vertical-align: middle;
  }

  .navbar__actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-16);
    margin-left: auto;
  }

  .navbar__actions :global(.navbar__cta) {
    position: relative;
    z-index: var(--z-menu-controls);
  }

  /* Neutraal: keuzeknoppen als link (Button als vorm) */
  .navbar__choice-link {
    display: inline-flex;
    text-decoration: none;
  }

  .navbar__choice-link :global(.navbar__choice--short) {
    display: none;
  }

  .navbar__menu {
    position: relative;
  }

  .navbar__menu :global(.navbar__toggle) {
    position: relative;
    z-index: var(--z-menu-controls);
  }

  @media (min-width: 1440px) {
    .navbar__brand,
    .navbar__actions {
      width: var(--navbar-side-width);
    }
  }

  @media (max-width: 767px) {
    .navbar__logo :global(img) {
      width: var(--logo-width-mobile);
    }
  }

  @media (max-width: 479px) {
    .navbar__actions :global(.navbar__cta) {
      display: none;
    }

    .navbar__actions:has(.navbar__choice-link) {
      gap: var(--space-8);
    }

    /* Korte labels (Events / Business) passen naast het logo */
    .navbar__choice-link:has(:global(.navbar__choice--short)) :global(.navbar__choice--full) {
      display: none;
    }

    .navbar__choice-link :global(.navbar__choice--short) {
      display: inline-flex;
      padding-inline: var(--space-12);
    }
  }
</style>
