---
/**
 * Polaroidgalerij "Bold backstage": sticky kop en polaroids die bij het scrollen
 * als een stapel over elkaar schuiven (pure CSS, position: sticky).
 * Een polaroid is nooit hoger dan wat er onder de kop in beeld past (foto's 3:2): de
 * maximale breedte volgt de schermhoogte, zodat hij ook op lage laptopschermen heel blijft.
 * Achtergrond "donkere kamer": effen donker vlak (dekt de meescrollende paginatextuur af)
 * met een rode gloed die schermhoog blijft staan; loopt in de sectiemarges zacht over.
 */
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Polaroid, { type PolaroidPhoto } from '../ui/Polaroid.astro';
import type { HeadingGradient } from '../ui/Heading.astro';

export interface PolaroidStackProps {
  eyebrow: string;
  title: string;
  gradient?: HeadingGradient;
  photos: PolaroidPhoto[];
}

type Props = PolaroidStackProps;

const { eyebrow, title, gradient = 'green', photos } = Astro.props;
/** Kantelingen per positie (Webflow custom CSS), herhalend na 8 */
const rotations = ['-1.5deg', '1.2deg', '-0.8deg', '2deg', '-1.8deg', '0.6deg', '-2.2deg', '1.5deg'];
---

<section class="polaroids">
  <div class="polaroids__bg" aria-hidden="true">
    <div class="polaroids__light"></div>
  </div>

  <div class="polaroids__header" data-animate>
    <Container>
      <div class="polaroids__row">
        <div class="polaroids__header-col">
          <SectionHeading eyebrow={eyebrow} title={title} gradient={gradient} spacing="none" />
        </div>
      </div>
    </Container>
  </div>

  <ul class="polaroids__list" role="list" data-animate>
    {
      photos.map((photo, index) => (
        <li class="polaroids__item" style={`--polaroid-rotate:${rotations[index % rotations.length]}`}>
          <Container>
            <div class="polaroids__row">
              <div class="polaroids__col">
                <Polaroid {...photo} sizes="(max-width: 991px) 100vw, (max-width: 1439px) 900px, 860px" />
              </div>
            </div>
          </Container>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .polaroids {
    position: relative;
    isolation: isolate;
    margin-block: var(--section-space);
  }

  /* Loopt door in de marges boven en onder (daar de overgang), zodat de afstand tot de
     buursecties gelijk blijft. Geen overflow: hidden, anders werkt sticky niet. */
  .polaroids__bg {
    position: absolute;
    inset: calc(-1 * var(--section-space)) 0;
    z-index: var(--z-below);
    background-color: var(--color-darkroom);
    mask-image: linear-gradient(
      var(--color-transparent),
      var(--color-black) var(--section-space),
      var(--color-black) calc(100% - var(--section-space)),
      var(--color-transparent)
    );
    pointer-events: none;
  }

  .polaroids__light {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    background-image:
      radial-gradient(ellipse 70% 55% at 50% 0%, var(--color-darkroom-glow), var(--color-transparent)),
      radial-gradient(ellipse 120% 90% at 50% 10%, var(--color-darkroom-glow-soft), var(--color-transparent)),
      radial-gradient(ellipse 100% 80% at 50% 45%, var(--color-transparent) 55%, var(--color-black-a50));
  }

  .polaroids__header {
    position: sticky;
    top: var(--polaroids-header-top);
    z-index: 0;
    margin-bottom: var(--space-48);
  }

  .polaroids__row {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    margin-inline: var(--row-margin);
  }

  .polaroids__header-col {
    width: 100%;
    padding-inline: var(--column-gap);
  }

  .polaroids__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .polaroids__item {
    position: sticky;
    top: var(--polaroids-item-top);
    z-index: var(--z-base);
  }

  .polaroids__col {
    width: 83.3333%;
    padding-inline: var(--column-gap);
  }

  /* Hoogte in beeld = schermhoogte − sticky top − lucht; breedte = 1,5 × de fotohoogte
     plus de witte rand (12px opzij, 12 + 24px boven/onder) */
  .polaroids__col :global(.polaroid) {
    max-width: calc((100vh - var(--polaroids-item-top) - var(--polaroids-bottom-gap)) * 1.5 - var(--space-30));
    max-width: calc((100svh - var(--polaroids-item-top) - var(--polaroids-bottom-gap)) * 1.5 - var(--space-30));
    margin-inline: auto;
  }

  @media (min-width: 1440px) {
    .polaroids__col {
      width: 66.6667%;
    }
  }

  @media (max-width: 991px) {
    .polaroids__col {
      width: 100%;
    }
  }

  @media (max-width: 479px) {
    .polaroids__header {
      min-height: var(--polaroids-header-top);
      margin-bottom: var(--space-30);
    }
  }
</style>
