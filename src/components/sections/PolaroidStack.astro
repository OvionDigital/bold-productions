---
/**
 * Polaroidgalerij "Bold backstage": kop (scrolt mee) en polaroids die bij het scrollen
 * als een stapel over elkaar schuiven (pure CSS, position: sticky).
 *
 * Achter de foto's zit een eigen "bevroren" achtergrond (.polaroids__backdrop): een
 * sticky laag die precies zo lang blijft staan als de foto's zelf, zodat de normale
 * paginatextuur niet zichtbaar meescrolt terwijl de foto's stilstaan. Hij hergebruikt
 * --page-bg-image (CSS custom property, overerft van PageBackground) — dus dezelfde
 * afbeelding, geen extra download, en dezelfde is-loaded-vertraging voor de LCP.
 */
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Polaroid, { type PolaroidPhoto } from '../ui/Polaroid.astro';
import type { HeadingGradient } from '../ui/Heading.astro';

export interface PolaroidStackProps {
  eyebrow: string;
  title: string;
  gradient?: HeadingGradient;
  photos: PolaroidPhoto[];
}

type Props = PolaroidStackProps;

const { eyebrow, title, gradient = 'green', photos } = Astro.props;
/** Kantelingen per positie (Webflow custom CSS), herhalend na 8 */
const rotations = ['-1.5deg', '1.2deg', '-0.8deg', '2deg', '-1.8deg', '0.6deg', '-2.2deg', '1.5deg'];
---

<section class="polaroids">
  <div class="polaroids__header" data-animate>
    <Container>
      <div class="polaroids__row">
        <div class="polaroids__header-col">
          <SectionHeading eyebrow={eyebrow} title={title} gradient={gradient} spacing="none" />
        </div>
      </div>
    </Container>
  </div>

  <div class="polaroids__stack">
    <div class="polaroids__backdrop" aria-hidden="true"></div>
    <ul class="polaroids__list" role="list" data-animate>
      {
        photos.map((photo, index) => (
          <li class="polaroids__item" style={`--polaroid-rotate:${rotations[index % rotations.length]}`}>
            <Container>
              <div class="polaroids__row">
                <div class="polaroids__col">
                  <Polaroid {...photo} sizes="(max-width: 991px) 100vw, (max-width: 1439px) 900px, 860px" />
                </div>
              </div>
            </Container>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .polaroids {
    position: relative;
    margin-block: var(--section-space);
  }

  .polaroids__header {
    position: relative;
    z-index: 0;
    margin-bottom: var(--space-48);
  }

  .polaroids__row {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    margin-inline: var(--row-margin);
  }

  .polaroids__header-col {
    width: 100%;
    padding-inline: var(--column-gap);
  }

  .polaroids__stack {
    position: relative;
  }

  /*
   * Sticky achtergrond, exact zo lang "actief" als de foto's zelf (zelfde
   * scroll-budget: begint bovenaan de stack, laat los aan het einde ervan).
   * Neemt geen ruimte in het document in (negatieve ondermarge compenseert de
   * eigen hoogte), dus de lijst erna schuift niet mee.
   */
  .polaroids__backdrop {
    position: sticky;
    top: 0;
    z-index: var(--z-below);
    width: 100%;
    height: 100svh;
    margin-bottom: calc(-1 * 100svh);
    background-color: var(--color-page);
  }

  :global(html.is-loaded) .polaroids__backdrop,
  :global(html:not(.js)) .polaroids__backdrop {
    background-image: linear-gradient(var(--color-page-a70), var(--color-page-a70)), var(--page-bg-image);
    background-position:
      0 0,
      50% 0;
    background-repeat: repeat, no-repeat;
    background-size: auto, 100%;
  }

  .polaroids__list {
    /* Kolombreedte als deel van de rij; per breakpoint aangepast */
    --pl-fraction: 0.833333;
    --pl-max: var(--container-max);

    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    container-type: inline-size;
  }

  /*
   * Sticky en verticaal gecentreerd in de ruimte onder de vaste navbar.
   * De polaroidhoogte volgt uit de kolombreedte (cqi = breedte van de lijst):
   * container → rij (+ goten) → kolom → foto (min witte rand) / verhouding + randen.
   * De breedte is begrensd zodat de polaroid maximaal --polaroid-max-fill van de
   * vrije schermhoogte (onder de navbar) inneemt.
   */
  .polaroids__item {
    --pl-inner: calc(min(var(--pl-max), 100cqi) - 2 * var(--container-padding));
    --pl-col-by-width: calc((var(--pl-inner) + 2 * var(--column-gap)) * var(--pl-fraction) - 2 * var(--column-gap));
    --pl-col-by-height: calc(
      ((100svh - var(--navbar-height)) * var(--polaroid-max-fill) - var(--space-12) - var(--space-24)) *
        var(--polaroid-ratio) + 2 * var(--space-12)
    );
    --pl-col: min(var(--pl-col-by-width), var(--pl-col-by-height));
    --pl-height: calc(
      (var(--pl-col) - 2 * var(--space-12)) / var(--polaroid-ratio) + var(--space-12) + var(--space-24)
    );

    position: sticky;
    top: max(var(--navbar-height), calc(var(--navbar-height) + (100svh - var(--navbar-height) - var(--pl-height)) / 3));
    z-index: var(--z-base);
  }

  .polaroids__col {
    width: calc(var(--pl-col) + 2 * var(--column-gap));
    padding-inline: var(--column-gap);
  }

  @media (min-width: 1440px) {
    .polaroids__list {
      --pl-fraction: 0.666667;
    }
  }

  @media (max-width: 991px) {
    .polaroids__list {
      --pl-fraction: 1;
    }
  }

  @media (max-width: 767px) {
    .polaroids__list {
      --pl-max: 100cqi;
    }
  }

  @media (max-width: 767px) {
    .polaroids {
      padding-block: var(--space-96);
    }
  }

  @media (max-width: 479px) {
    .polaroids {
      margin-block: 0;
    }

    .polaroids__header {
      min-height: var(--polaroids-header-top);
      margin-bottom: var(--space-30);
    }
  }
</style>
