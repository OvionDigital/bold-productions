---
/**
 * Brede foto met gecentreerde titel + intro eroverheen (Webflow .section-bg-image-text).
 * - Desktop: tekst verticaal gecentreerd op de foto, radiale donkere overlay.
 * - ≤991: tekst onderaan de foto. ≤767: tekst onder de foto in een donker blok.
 * - `id` = 'cinema' activeert de popcorn-cursor (scripts/cinema-cursor.ts).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Heading, { type HeadingGradient } from '../ui/Heading.astro';

export interface ImageFeatureProps {
  id?: string;
  title: string;
  gradient?: HeadingGradient;
  text: string;
  image: { src: ImageMetadata; alt: string };
}

type Props = ImageFeatureProps;

const { id, title, gradient = 'green', text, image } = Astro.props;
---

<section class="image-feature" id={id}>
  <div class="image-feature__container">
    <span class="image-feature__overlay" aria-hidden="true"></span>
    <Picture
      src={image.src}
      alt={image.alt}
      widths={[480, 768, 1080, 1440, 1920]}
      sizes="(max-width: 767px) 100vw, calc(100vw - 96px)"
      formats={['avif', 'webp']}
      loading="lazy"
      decoding="async"
      class="image-feature__image"
    />
    <div class="image-feature__content">
      <Heading as="h2" text={title} gradient={gradient} align="center" flush class="image-feature__title" />
      <p class="image-feature__text">{text}</p>
    </div>
  </div>
</section>

<style>
  .image-feature {
    position: relative;
    z-index: var(--z-base);
    padding: var(--space-48);
    overflow: hidden;
  }

  .image-feature__container {
    position: relative;
    width: 100%;
    padding-inline: var(--container-padding-wide);
  }

  .image-feature__overlay {
    position: absolute;
    inset: 0;
    z-index: var(--z-media);
    width: 100%;
    height: 100%;
    margin-inline: auto;
    background-image: radial-gradient(circle, var(--color-black-a40), var(--color-black-a95));
  }

  .image-feature :global(.image-feature__image) {
    position: relative;
    z-index: var(--z-base);
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .image-feature__content {
    position: absolute;
    top: 50%;
    left: var(--space-48);
    right: var(--space-48);
    z-index: var(--z-overlay);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    transform: translateY(-50%);
  }

  .image-feature__content :global(.image-feature__title) {
    margin: 0 auto 0.5em;
  }

  .image-feature__text {
    max-width: var(--container-narrow);
    margin-bottom: 0;
    font-size: var(--fs-intro);
    font-weight: var(--fw-medium);
    text-align: center;
  }

  @media (min-width: 1920px) {
    .image-feature__container {
      padding-inline: 0;
    }
  }

  @media (max-width: 991px) {
    .image-feature {
      padding: var(--space-36) 0;
    }

    .image-feature__overlay {
      width: calc(100% - 2 * var(--space-36));
    }

    .image-feature__content {
      top: auto;
      bottom: var(--space-48);
      transform: none;
    }

    .image-feature__text {
      font-size: var(--fs-base);
    }
  }

  @media (max-width: 767px) {
    .image-feature__overlay {
      display: none;
    }

    .image-feature__content {
      position: static;
      padding: var(--space-36);
      background-color: var(--color-black-a48);
    }
  }

  @media (max-width: 479px) {
    .image-feature__content {
      padding: var(--space-24) var(--space-16);
    }
  }
</style>
