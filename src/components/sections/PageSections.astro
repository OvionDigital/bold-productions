---
/**
 * Rendert een lijst secties (lib/sections.ts; uit src/data/pages of Sanity) met de
 * bestaande sectiecomponenten. Zelf geen opmaak: elke sectie regelt zijn eigen stijl
 * en afstand. Een kruimelpad als eerste sectie (pagina zonder hero) krijgt ruimte
 * voor de vaste navbar.
 */
import Hero from './Hero.astro';
import SplitHero from './SplitHero.astro';
import LogoMarquee from './LogoMarquee.astro';
import IntroHighlight from './IntroHighlight.astro';
import Timeline from './Timeline.astro';
import Testimonials from './Testimonials.astro';
import PolaroidStack from './PolaroidStack.astro';
import TextMedia from './TextMedia.astro';
import CaseSpotlight from './CaseSpotlight.astro';
import ImageFeature from './ImageFeature.astro';
import ServiceTiles from './ServiceTiles.astro';
import Faq from './Faq.astro';
import RichTextSection from './RichTextSection.astro';
import FullWidthImage from './FullWidthImage.astro';
import VideoFeature from './VideoFeature.astro';
import ContactSection from './ContactSection.astro';
import MapSection from './MapSection.astro';
import CaseGrid from './CaseGrid.astro';
import CaseFacts from './CaseFacts.astro';
import LinkGroups from './LinkGroups.astro';
import Breadcrumbs, { type Crumb } from '../layout/Breadcrumbs.astro';
import ContactForm from '../ui/ContactForm.astro';
import { getForm } from '../../data/forms';
import { breadcrumbLabels } from '../../data/navigation';
import type { PageSection } from '../../lib/sections';

interface Props {
  sections: PageSection[];
  breadcrumbs: Crumb[];
}

const { sections, breadcrumbs } = Astro.props;
---

{
  sections.map((section, index) => {
    switch (section.type) {
      case 'hero':
        return <Hero {...section.props} />;
      case 'splitHero':
        return <SplitHero {...section.props} />;
      case 'breadcrumbs':
        // /events en /business: geen kruimelpad (zou alleen het home-icoon zijn)
        return breadcrumbs.length > 1 && <Breadcrumbs items={breadcrumbs} label={breadcrumbLabels.nav} standalone={index === 0} />;
      case 'logoMarquee':
        return <LogoMarquee {...section.props} />;
      case 'introHighlight':
        return <IntroHighlight {...section.props} />;
      case 'timeline':
        return <Timeline {...section.props} />;
      case 'testimonials':
        return <Testimonials {...section.props} />;
      case 'polaroidStack':
        return <PolaroidStack {...section.props} />;
      case 'textMedia':
        return section.form ? (
          <TextMedia {...section.props}>
            <ContactForm slot="content" {...getForm(section.form, Astro.url.pathname)} />
          </TextMedia>
        ) : (
          <TextMedia {...section.props} />
        );
      case 'caseSpotlight':
        return <CaseSpotlight {...section.props} />;
      case 'imageFeature':
        return <ImageFeature {...section.props} />;
      case 'serviceTiles':
        return <ServiceTiles {...section.props} />;
      case 'faq':
        return <Faq {...section.props} />;
      case 'richText':
        return <RichTextSection {...section.props} standalone={index === 0} />;
      case 'fullWidthImage':
        return <FullWidthImage {...section.props} />;
      case 'videoFeature':
        return <VideoFeature {...section.props} />;
      case 'contactSection':
        return (
          <ContactSection {...section.props}>
            <ContactForm slot="form" {...getForm(section.form, Astro.url.pathname)} />
          </ContactSection>
        );
      case 'map':
        return <MapSection {...section.props} />;
      case 'caseGrid':
        return <CaseGrid {...section.props} />;
      case 'caseFacts':
        return <CaseFacts {...section.props} />;
      case 'linkGroups':
        return <LinkGroups {...section.props} />;
    }
  })
}
