---
/**
 * Tekst + beeld/video (Webflow-component "text-image"): titel met gradient, rich text
 * en knop naast een beeld of Vimeo-video, optioneel met driehoekjes.
 * - `reverse` zet het beeld links. Op ≤991 staat het beeld boven de tekst.
 * - media: Vimeo (vierkant) of afbeelding (staand 2:3, Webflow .image-5).
 * - `spacing`: 'margin' of 'section'; beide 192 marge (--section-space), 'section' knipt horizontale
 *   overflow af (verticaal niet: de driehoekjes steken boven en onder het beeld uit).
 * - `intro`: gecentreerde titel + tekst boven de rij (Webflow .form-compact-intro).
 * - `links`: contactlinks (bellen, mailen, WhatsApp) onder de tekst.
 * - Slot "content" vervangt de tekstkolom (bijv. een formulier).
 * - `id` = 'cinema' activeert de popcorn-cursor (scripts/cinema-cursor.ts).
 */
import type { ImageMetadata } from 'astro';
import Container from '../ui/Container.astro';
import Heading, { type HeadingGradient } from '../ui/Heading.astro';
import RichText from '../ui/RichText.astro';
import Button, { type Accent } from '../ui/Button.astro';
import VimeoEmbed from '../ui/VimeoEmbed.astro';
import DecoTriangles from '../ui/DecoTriangles.astro';
import CmsPicture from '../ui/CmsPicture.astro';
import ContactLinks, { type ContactLink } from '../ui/ContactLinks.astro';
import type { RemoteImage } from '../../lib/sanity/image';
import type { Rich } from '../../lib/rich';

type Media =
  | { type: 'vimeo'; id: string; hash?: string; title: string }
  | { type: 'image'; src: ImageMetadata | RemoteImage; alt: string };

export interface TextMediaProps {
  id?: string;
  title?: string;
  gradient?: HeadingGradient;
  body?: Rich;
  /** Bel/mail/WhatsApp-links onder de tekst (bijv. "Mail Mike" op de homepage) */
  links?: ContactLink[];
  cta?: { label: string; href: string; accent?: Accent };
  media: Media;
  reverse?: boolean;
  triangles?: boolean;
  spacing?: 'margin' | 'section';
  intro?: { title: string; gradient?: HeadingGradient; text: Rich };
  animate?: boolean;
}

type Props = TextMediaProps;

const {
  id,
  title,
  gradient = 'orange',
  body,
  links,
  cta,
  media,
  reverse = false,
  triangles = false,
  spacing = 'margin',
  intro,
  animate = true,
} = Astro.props;
const hasCustomContent = Astro.slots.has('content');
---

<section
  class:list={['text-media', `text-media--${spacing}`, { 'text-media--reverse': reverse }]}
  id={id}
>
  <Container>
    {
      intro && (
        <div class="text-media__intro" data-animate={animate ? '' : undefined}>
          <Heading as="h2" text={intro.title} gradient={intro.gradient ?? 'orange'} align="center" flush />
          <RichText content={intro.text} class="text-media__intro-text" />
        </div>
      )
    }
    <div class="text-media__row" data-animate-stagger={animate ? '' : undefined}>
      <div class="text-media__col">
        {
          hasCustomContent ? (
            <slot name="content" />
          ) : (
            <div class="text-media__text">
              <div class="text-media__copy">
                {title && <Heading as="h2" text={title} gradient={gradient} flush />}
                {body && <RichText content={body} class="text-media__body" />}
                {links && links.length > 0 && <ContactLinks links={links} />}
              </div>
              {cta && <Button label={cta.label} href={cta.href} accent={cta.accent} />}
            </div>
          )
        }
      </div>
      <div class="text-media__col">
        <div class:list={['text-media__media', `text-media__media--${media.type}`]}>
          {
            media.type === 'vimeo' ? (
              <VimeoEmbed id={media.id} hash={media.hash} title={media.title} ratio="square" />
            ) : (
              <CmsPicture
                src={media.src}
                alt={media.alt}
                aspectRatio={2 / 3}
                widths={[400, 600, 800, 1200]}
                sizes="(max-width: 479px) 75vw, (max-width: 991px) 50vw, 604px"
                loading="lazy"
                decoding="async"
                class="text-media__image"
              />
            )
          }
          {triangles && <DecoTriangles id={`${id ?? 'text-media'}-tri`} />}
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .text-media {
    position: relative;
    z-index: var(--z-base);
    margin-block: var(--section-space);
  }

  .text-media--section {
    overflow-x: clip;
  }

  .text-media__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-24);
    max-width: var(--container-narrow);
    margin: 0 auto var(--space-48);
    text-align: center;
  }

  .text-media__row {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-inline: var(--row-margin);
  }

  .text-media--reverse .text-media__row {
    flex-direction: row-reverse;
  }

  .text-media__col {
    width: 50%;
    padding-inline: var(--column-gap);
  }

  .text-media__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-48);
    max-width: 100%;
  }

  .text-media__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-24);
    max-width: 100%;
  }

  .text-media__media {
    position: relative;
    width: calc(100% - var(--space-32));
    margin-left: var(--space-32);
    aspect-ratio: 1;
  }

  /*
   * Afbeelding: staand 2:3 (Webflow .image-5); de wrapper groeit mee. Het vierkant
   * van de wrapper geldt alleen voor video: zonder width/height-attributen (Sanity-
   * beeld, zie CmsPicture) zou height: 100% anders dat vierkant overnemen.
   */
  .text-media__media--image {
    aspect-ratio: auto;
  }

  .text-media__media--image :global(picture) {
    display: block;
  }

  .text-media__media--image :global(.text-media__image) {
    display: block;
    aspect-ratio: 2 / 3;
  }

  .text-media--reverse .text-media__media {
    margin-left: 0;
    margin-right: auto;
  }

  .text-media__media :global(.text-media__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 1920px) {
    .text-media__col {
      width: 41.6667%;
    }

    .text-media__media {
      max-width: 550px;
      margin-left: auto;
    }
  }

  @media (max-width: 991px) {
    .text-media__row,
    .text-media--reverse .text-media__row {
      flex-direction: column-reverse;
      justify-content: flex-start;
    }

    .text-media__col {
      width: 100%;
    }

    .text-media__text {
      gap: var(--space-32);
    }

    .text-media__media,
    .text-media--reverse .text-media__media {
      width: 50%;
      margin: 0 auto var(--space-48);
    }
  }

  @media (max-width: 479px) {
    .text-media__media,
    .text-media--reverse .text-media__media {
      width: 75%;
    }
  }
</style>
