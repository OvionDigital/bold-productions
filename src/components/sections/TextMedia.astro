---
/**
 * Tekst + beeld/video (Webflow-component "text-image"): titel met gradient, rich text
 * en knop naast een vierkant beeld of Vimeo-video, optioneel met driehoekjes.
 * `reverse` zet het beeld links. Op ≤991 staat het beeld boven de tekst.
 * `id` = 'cinema' activeert de popcorn-cursor (scripts/cinema-cursor.ts).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Container from '../ui/Container.astro';
import Heading, { type HeadingGradient } from '../ui/Heading.astro';
import RichText from '../ui/RichText.astro';
import Button, { type Accent } from '../ui/Button.astro';
import VimeoEmbed from '../ui/VimeoEmbed.astro';
import DecoTriangles from '../ui/DecoTriangles.astro';
import type { Rich } from '../../lib/rich';

type Media =
  | { type: 'vimeo'; id: string; hash?: string; title: string }
  | { type: 'image'; src: ImageMetadata; alt: string };

export interface TextMediaProps {
  id?: string;
  title: string;
  gradient?: HeadingGradient;
  body: Rich;
  cta?: { label: string; href: string; accent?: Accent };
  media: Media;
  reverse?: boolean;
  triangles?: boolean;
}

type Props = TextMediaProps;

const { id, title, gradient = 'orange', body, cta, media, reverse = false, triangles = false } = Astro.props;
---

<section class:list={['text-media', { 'text-media--reverse': reverse }]} id={id} data-animate>
  <Container>
    <div class="text-media__row">
      <div class="text-media__col">
        <div class="text-media__text">
          <div class="text-media__copy">
            <Heading as="h2" text={title} gradient={gradient} flush />
            <RichText content={body} class="text-media__body" />
          </div>
          {cta && <Button label={cta.label} href={cta.href} accent={cta.accent} />}
        </div>
      </div>
      <div class="text-media__col">
        <div class="text-media__media">
          {
            media.type === 'vimeo' ? (
              <VimeoEmbed id={media.id} hash={media.hash} title={media.title} ratio="square" />
            ) : (
              <Picture
                src={media.src}
                alt={media.alt}
                widths={[400, 600, 800, 1100]}
                sizes="(max-width: 479px) 75vw, (max-width: 991px) 50vw, 600px"
                formats={['avif', 'webp']}
                loading="lazy"
                decoding="async"
                class="text-media__image"
              />
            )
          }
          {triangles && <DecoTriangles id={`${id ?? 'text-media'}-tri`} />}
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .text-media {
    position: relative;
    z-index: var(--z-base);
    margin-block: var(--section-space);
  }

  .text-media__row {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-inline: var(--row-margin);
  }

  .text-media--reverse .text-media__row {
    flex-direction: row-reverse;
  }

  .text-media__col {
    width: 50%;
    padding-inline: var(--column-gap);
  }

  .text-media__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-48);
    max-width: 100%;
  }

  .text-media__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-24);
    max-width: 100%;
  }

  .text-media__media {
    position: relative;
    width: calc(100% - var(--space-32));
    margin-left: var(--space-32);
    aspect-ratio: 1;
  }

  .text-media--reverse .text-media__media {
    margin-left: 0;
    margin-right: auto;
  }

  .text-media__media :global(.text-media__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 1920px) {
    .text-media__col {
      width: 41.6667%;
    }

    .text-media__media {
      max-width: 550px;
      margin-left: auto;
    }
  }

  @media (max-width: 991px) {
    .text-media__row,
    .text-media--reverse .text-media__row {
      flex-direction: column-reverse;
      justify-content: flex-start;
    }

    .text-media__col {
      width: 100%;
    }

    .text-media__text {
      gap: var(--space-32);
    }

    .text-media__media,
    .text-media--reverse .text-media__media {
      width: 50%;
      margin: 0 auto var(--space-48);
    }
  }

  @media (max-width: 479px) {
    .text-media__media,
    .text-media--reverse .text-media__media {
      width: 75%;
    }
  }
</style>
