---
/**
 * Feitenbalk op een casepagina (Webflow .four-columns): klant, datum, doelgroep en
 * diensten naast elkaar in een glazen kader. ≤991 twee per rij, ≤479 onder elkaar.
 * Meerdere waarden worden met komma's gescheiden (zoals live).
 */

export interface CaseFact {
  label: string;
  values: string[];
}

export interface CaseFactsProps {
  items: CaseFact[];
}

type Props = CaseFactsProps;

const { items } = Astro.props;
---

<section class="case-facts" data-animate>
  <div class="case-facts__container">
    <dl class="case-facts__box">
      {
        items.map((fact) => (
          <div class="case-facts__item">
            <dt class="case-facts__label">{fact.label}</dt>
            <dd class="case-facts__value">{fact.values.join(', ')}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .case-facts {
    position: relative;
    z-index: var(--z-base);
    margin-block: var(--section-space);
  }

  /* Webflow .container.four-columns-container: volle breedte met ruime goot, ≥1280 max 1140px */
  .case-facts__container {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--container-padding-wide);
  }

  .case-facts__box {
    display: flex;
    justify-content: center;
    align-items: stretch;
    width: 100%;
    margin: 0;
    border: var(--border-width) solid var(--color-gray-dark);
    background-image: var(--gradient-glass);
    -webkit-backdrop-filter: blur(var(--blur-sm));
    backdrop-filter: blur(var(--blur-sm));
  }

  .case-facts__item {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    gap: var(--space-16);
    width: 100%;
    padding: var(--space-48) var(--space-24);
  }

  .case-facts__label {
    color: var(--color-green);
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    line-height: var(--lh-body);
    text-align: center;
    text-transform: uppercase;
  }

  .case-facts__value {
    margin: 0;
    color: var(--color-white);
    text-align: center;
  }

  @media (min-width: 1280px) {
    .case-facts__container {
      max-width: var(--case-facts-max);
      padding-inline: var(--column-gap);
    }
  }

  @media (max-width: 991px) {
    .case-facts__container {
      max-width: var(--container-max);
    }

    .case-facts__box {
      flex-wrap: wrap;
    }

    .case-facts__item {
      width: 50%;
    }
  }

  @media (max-width: 479px) {
    .case-facts__box {
      flex-direction: column;
      align-items: center;
    }

    .case-facts__item {
      width: 100%;
    }
  }
</style>
