---
/**
 * Beeldtegels die naar dienstpagina's linken (Webflow .five-blocks-section).
 * Kop + tekst, daarna staande tegels (2:3) met titel. Hover: tegel groeit, titel oranje.
 * ≥1440 alle tegels op één rij (even tegels 48px lager), daaronder 3 / 2 / 1 per rij.
 *
 * Variant `team` (Webflow .team-item): geen links maar teamleden, 9:16 (≥1920 2:3), met
 * functie onder de naam en een video die bij hover afspeelt (scripts/hover-video.ts).
 */
import type { ImageMetadata } from 'astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import CmsPicture from '../ui/CmsPicture.astro';
import type { HeadingGradient } from '../ui/Heading.astro';
import type { RemoteImage } from '../../lib/sanity/image';
import type { Rich } from '../../lib/rich';
import { toLines } from '../../lib/text';

export interface ServiceTile {
  label: string;
  /** Link (variant services) */
  href?: string;
  image: { src: ImageMetadata | RemoteImage; alt: string };
  /** Regel onder de titel, bijv. de functie van een teamlid ('
' = nieuwe regel) */
  subtitle?: string;
  /** Video-URL die bij hover afspeelt (variant team) */
  video?: string;
}

export interface ServiceTilesProps {
  title: string;
  gradient?: HeadingGradient;
  text?: Rich;
  items: ServiceTile[];
  variant?: 'services' | 'team';
}

type Props = ServiceTilesProps;

const { title, gradient = 'yellow', text, items, variant = 'services' } = Astro.props;
---

<section class:list={['service-tiles', `service-tiles--${variant}`]}>
  <Container data-animate>
    <SectionHeading title={title} gradient={gradient} text={text} />
  </Container>
  <Container width="wide">
    <ul class="service-tiles__row" role="list" data-animate-stagger>
      {
        items.map((item) => {
          const Tile = item.href ? 'a' : 'div';
          return (
            <li class="service-tiles__item">
              <Tile href={item.href} class="service-tiles__tile" data-hover-video={item.video ? '' : undefined}>
                {item.video && <video class="service-tiles__video" data-src={item.video} muted loop playsinline preload="none" aria-hidden="true" />}
                <CmsPicture
                  src={item.image.src}
                  alt={item.image.alt}
                  aspectRatio={2 / 3}
                  widths={[320, 480, 640, 800]}
                  sizes="(max-width: 479px) 100vw, (max-width: 767px) 50vw, (max-width: 1439px) 33vw, 20vw"
                  formats={['avif', 'webp']}
                  loading="lazy"
                  decoding="async"
                  class="service-tiles__image"
                />
                <span class="service-tiles__overlay" aria-hidden="true" />
                <h3 class="service-tiles__title">{item.label}</h3>
                {item.subtitle && <p class="service-tiles__subtitle">{toLines(item.subtitle).map((line, i) => (i > 0 ? [<br />, line] : line))}</p>}
              </Tile>
            </li>
          );
        })
      }
    </ul>
  </Container>
</section>

<style>
  .service-tiles {
    position: relative;
    z-index: var(--z-base);
    margin-block: var(--section-space);
  }

  .service-tiles__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    row-gap: var(--space-24);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .service-tiles__item {
    flex: none;
    width: 33.3333%;
    max-width: 100%;
    padding-inline: var(--column-gap);
  }

  .service-tiles__tile {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    aspect-ratio: 2 / 3;
    margin-inline: auto;
    padding-inline: var(--space-24);
    color: var(--color-white);
    text-decoration: none;
    transition: transform var(--duration-fast);
  }

  .service-tiles--team .service-tiles__tile {
    flex-direction: column;
    gap: var(--space-24);
    aspect-ratio: 9 / 16;
    cursor: var(--cursor-default);
  }

  .service-tiles__video {
    position: absolute;
    inset: 0;
    z-index: var(--z-base);
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .service-tiles__tile:hover .service-tiles__video {
    opacity: 1;
  }

  .service-tiles__subtitle {
    position: relative;
    z-index: var(--z-content);
    margin: 0;
    line-height: var(--lh-body);
    text-align: center;
    transition: color var(--duration-fast);
  }

  .service-tiles__tile:hover {
    color: var(--color-orange);
    transform: scale(1.05);
    box-shadow: var(--shadow-card-hover);
  }

  .service-tiles__tile :global(.service-tiles__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service-tiles__overlay {
    position: absolute;
    inset: 0;
    z-index: var(--z-media);
    background-image: var(--gradient-image-overlay);
    transition: background-color var(--duration-fast);
  }

  .service-tiles__tile:hover .service-tiles__overlay {
    background-color: var(--color-black-a50);
  }

  .service-tiles__title {
    position: relative;
    z-index: var(--z-media);
    margin: 0;
    text-align: center;
    text-transform: uppercase;
    transition: color var(--duration-fast);
  }

  @media (min-width: 1440px) {
    .service-tiles__item {
      flex: 1;
    }

    .service-tiles__item:nth-child(even) {
      padding-top: var(--space-48);
    }

    .service-tiles__title {
      font-size: var(--fs-lg);
    }
  }

  @media (min-width: 1920px) {
    .service-tiles__title {
      font-size: var(--fs-xl);
    }

    .service-tiles--team .service-tiles__tile {
      aspect-ratio: 2 / 3;
    }
  }

  @media (max-width: 991px) {
    .service-tiles__title {
      font-size: var(--fs-md);
    }
  }

  @media (max-width: 767px) {
    .service-tiles__item {
      width: 50%;
    }
  }

  @media (max-width: 479px) {
    .service-tiles__item {
      width: 100%;
    }
  }
</style>
