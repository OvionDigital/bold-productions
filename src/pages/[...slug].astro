---
/**
 * Alle pagina's behalve de homepage: /events, dienst-, doelgroep-, case- en overige pagina's.
 * Inhoud uit Sanity (pagina's en cases die de klant beheert) of, zonder Sanity, uit
 * src/data — zie src/lib/pages.ts. Header, menu, footer en WhatsApp-knop komen uit
 * BaseLayout; de inhoud is een lijst secties (PageSections).
 * Preview-build (lib/preview.ts): geen getStaticPaths, de pagina wordt per verzoek opgezocht.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageSections from '../components/sections/PageSections.astro';
import { EVENTS_SLUG, getRoutedPages, type BuiltPage } from '../lib/pages';
import { eventsCatalog, eventsCustomers, founder, homepageReviews } from '../data/seo';
import { testimonials } from '../data/testimonials';
import type { Review } from '../lib/structured-data';

export const getStaticPaths = (async () => {
  const pages = await getRoutedPages();
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}) satisfies GetStaticPaths;

interface Props {
  page?: BuiltPage;
}

let page = Astro.props.page;
if (!page) {
  const pages = await getRoutedPages();
  page = pages.find((p) => p.slug === Astro.params.slug);
  if (!page) {
    Astro.response.status = 404;
    page = pages.find((p) => p.slug === '404')!;
  }
}

/** /events (de vroegere homepage): reviews in de structured data, selectie van live (data/seo.ts) */
const reviews: Review[] | undefined =
  page.slug === EVENTS_SLUG
    ? homepageReviews.map((id) => {
        const t: { quote: string; name?: string; organisation?: string } = testimonials[id];
        return { body: t.quote, author: t.name ?? t.organisation ?? '', authorType: t.name ? 'Person' : 'Organization' };
      })
    : undefined;

/** Pagina over Bold met het team (Over Bold): de teamleden als employee, zoals live op /over */
const team = page.sections.find((s) => s.type === 'serviceTiles' && s.props.variant === 'team');
const employees =
  page.meta.schema?.type === 'webpage' && team?.type === 'serviceTiles' ? team.props.items.map((item) => item.label).filter((name) => name !== founder.name) : undefined;
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  ogImage={page.meta.ogImage}
  accent={page.accent}
  noindex={page.meta.noindex}
  canonicalPath={page.meta.canonical}
  structuredData={{ schema: page.meta.schema, breadcrumbs: page.breadcrumbs, reviews, catalog: reviews ? eventsCatalog : undefined, customers: reviews ? eventsCustomers : undefined, employees }}
>
  <PageSections sections={page.sections} breadcrumbs={page.breadcrumbs} />
</BaseLayout>
