---
/**
 * Alle pagina's behalve de homepage: /events, dienst-, doelgroep-, case- en overige pagina's.
 * Inhoud uit Sanity (pagina's en cases die de klant beheert) of, zonder Sanity, uit
 * src/data — zie src/lib/pages.ts. Header, menu, footer en WhatsApp-knop komen uit
 * BaseLayout; de inhoud is een lijst secties (PageSections).
 * Preview-build (lib/preview.ts): geen getStaticPaths, de pagina wordt per verzoek opgezocht.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageSections from '../components/sections/PageSections.astro';
import { getRoutedPages, type BuiltPage } from '../lib/pages';
import { pageFacts, pageKindOf } from '../lib/structured-data';

export const getStaticPaths = (async () => {
  const pages = await getRoutedPages();
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}) satisfies GetStaticPaths;

interface Props {
  page?: BuiltPage;
}

let page = Astro.props.page;
if (!page) {
  const pages = await getRoutedPages();
  page = pages.find((p) => p.slug === Astro.params.slug);
  if (!page) {
    Astro.response.status = 404;
    page = pages.find((p) => p.slug === '404')!;
  }
}

/** Structured data: kruimelpad alleen via indexeerbare pagina's (geen noindex, geen kopie) */
const indexable = new Set((await getRoutedPages()).filter((p) => !p.meta.noindex && !p.meta.canonical).map((p) => `/${p.slug}`));
const facts = await pageFacts(pageKindOf(page.slug), page.sections, Astro.site!);
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  ogImage={page.meta.ogImage}
  accent={page.accent}
  noindex={page.meta.noindex}
  canonicalPath={page.meta.canonical}
  structuredData={{
    slug: page.slug,
    name: page.title,
    breadcrumbs: page.breadcrumbs.filter((crumb, i) => i === page.breadcrumbs.length - 1 || (crumb.href && indexable.has(crumb.href))),
    facts,
    primaryImage: pageKindOf(page.slug) === 'case' ? page.meta.ogImage : undefined,
  }}
>
  <PageSections sections={page.sections} breadcrumbs={page.breadcrumbs} />
</BaseLayout>
