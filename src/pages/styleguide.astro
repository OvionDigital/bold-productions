---
/**
 * /styleguide — levend overzicht van tokens, UI-componenten en secties.
 * Regel: elk nieuw component of elke nieuwe variant komt eerst hier.
 * noindex; hoort niet in de sitemap.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { iconNames } from '../components/ui/icons';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Heading from '../components/ui/Heading.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { tokensByPrefix } from '../lib/tokens';
import Header from '../components/layout/Header.astro';
import WhatsAppButton from '../components/layout/WhatsAppButton.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import { breadcrumbLabels, contact, copyright, footerLogoAlt, header, legalLinks, navigation, socials } from '../data/navigation';
import Hero from '../components/sections/Hero.astro';
import LogoMarquee from '../components/sections/LogoMarquee.astro';
import IntroHighlight from '../components/sections/IntroHighlight.astro';
import RichText from '../components/ui/RichText.astro';
import Timeline from '../components/sections/Timeline.astro';
import BackgroundVideo from '../components/ui/BackgroundVideo.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import TestimonialCard from '../components/ui/TestimonialCard.astro';
import PolaroidStack from '../components/sections/PolaroidStack.astro';
import Polaroid from '../components/ui/Polaroid.astro';
import TextMedia from '../components/sections/TextMedia.astro';
import SplitHero from '../components/sections/SplitHero.astro';
import { page as homePage } from '../data/pages/home';
import { backstage, hero, intro, micDrop, testimonials, timeline, trustedBy } from '../data/home';
import CaseSpotlight from '../components/sections/CaseSpotlight.astro';
import ImageFeature from '../components/sections/ImageFeature.astro';
import ServiceTiles from '../components/sections/ServiceTiles.astro';
import Faq from '../components/sections/Faq.astro';
import ContactForm from '../components/ui/ContactForm.astro';
import { contactForm } from '../data/forms';
import { biggerThanTheDay, caseSpotlight, cinema, contactSection, faq, services } from '../data/events';
import RichTextSection from '../components/sections/RichTextSection.astro';
import FullWidthImage from '../components/sections/FullWidthImage.astro';
import VideoFeature from '../components/sections/VideoFeature.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import MapSection from '../components/sections/MapSection.astro';
import CaseGrid from '../components/sections/CaseGrid.astro';
import CaseFacts from '../components/sections/CaseFacts.astro';
import LinkGroups from '../components/sections/LinkGroups.astro';
import { getForm } from '../data/forms';
import { pages } from '../data/pages';
import { cases, caseGridProps } from '../data/cases';
import { caseFacts } from '../lib/cases';
import type { PageSection } from '../lib/sections';

/** Voorbeeldprops uit de homepage (src/data/pages/home.ts) */
const splitHero = homePage.sections.find((s) => s.type === 'splitHero')?.props;
const mailMikeSection = homePage.sections.find((s) => s.type === 'textMedia' && s.props.id === 'mail-mike');
const mailMike = mailMikeSection?.type === 'textMedia' ? mailMikeSection.props : undefined;

const colors = tokensByPrefix('--color-');
const gradients = tokensByPrefix('--gradient-');
const fontSizes = tokensByPrefix('--fs-');
const lineHeights = tokensByPrefix('--lh-');
const letterSpacings = tokensByPrefix('--ls-');
const families = tokensByPrefix('--font-');
const weights = tokensByPrefix('--fw-');
const spacing = tokensByPrefix('--space-');
const layout = tokensByPrefix('--section-', '--column-', '--row-', '--container-', '--navbar-');
const sizes = tokensByPrefix('--button-', '--icon-', '--carousel-', '--whatsapp-', '--logo-', '--hero-', '--split-hero-');
const radii = tokensByPrefix('--radius-', '--border-');
const shadows = tokensByPrefix('--shadow-');
const blurs = tokensByPrefix('--blur-');
const motion = tokensByPrefix('--duration-', '--ease-', '--marquee-');
const layers = tokensByPrefix('--z-');

/** Voorbeeldprops uit de echte pagina-inhoud (src/data/pages + cases): eerste sectie van dat type. */
const allSections: PageSection[] = [...pages.flatMap((p) => p.sections), ...cases.flatMap((c) => c.sections ?? [])];
function example<T extends PageSection['type']>(type: T) {
  const found = allSections.find((s): s is Extract<PageSection, { type: T }> => s.type === type);
  if (!found) throw new Error(`Geen voorbeeld voor sectie '${type}' in src/data`);
  return found;
}
const richTextExample = example('richText');
const fullWidthImageExample = example('fullWidthImage');
const videoFeatureExample = example('videoFeature');
const contactSectionExample = example('contactSection');
const mapExample = example('map');
const linkGroupsExample = example('linkGroups');
const teamExample = allSections.find((s) => s.type === 'serviceTiles' && s.props.variant === 'team') as Extract<PageSection, { type: 'serviceTiles' }>;

const accents = ['orange', 'yellow', 'green'] as const;
const variants = ['primary', 'outline', 'ghost'] as const;
const buttonSizes = ['small', 'default', 'large'] as const;

const nav = [
  ['kleuren', 'Kleuren'],
  ['typografie', 'Typografie'],
  ['spacing', 'Spacing'],
  ['vormen', 'Radii, schaduwen & blur'],
  ['overig', 'Overige tokens'],
  ['button', 'Button'],
  ['icon', 'Icon'],
  ['tekst', 'Eyebrow & Heading'],
  ['section-heading', 'SectionHeading'],
  ['container', 'Container'],
  ['layout', 'Layout'],
  ['secties', 'Secties'],
];

---

<BaseLayout
  title="Styleguide | Bold Productions"
  description="Interne styleguide met design tokens en componenten."
  noindex
  chrome={false}
>
  <div class="sg">
    <Container>
      <header class="sg-intro">
        <Eyebrow text="Bold Productions" />
        <Heading as="h1" size="h1" text="Styleguide" gradient="orange" flush />
        <p>
          Tokens komen rechtstreeks uit <code>src/styles/tokens.css</code>. Nieuwe componenten en varianten komen eerst
          hier, daarna pas op een pagina.
        </p>
        <nav class="sg-nav" aria-label="Styleguide-onderdelen">
          {nav.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
        </nav>
      </header>

      <!-- ─── Kleuren ─────────────────────────────────────────────── -->
      <section class="sg-section" id="kleuren">
        <h2 class="sg-title">Kleuren</h2>
        <div class="sg-swatches">
          {
            colors.map((t) => (
              <figure class="sg-swatch">
                <span class="sg-swatch__chip" style={`background:var(${t.name})`} />
                <figcaption>
                  <code>{t.name}</code>
                  <span>{t.value}</span>
                  {t.comment && <small>{t.comment}</small>}
                </figcaption>
              </figure>
            ))
          }
        </div>

        <h3 class="sg-subtitle">Gradients</h3>
        <div class="sg-swatches sg-swatches--wide">
          {
            gradients.map((t) => (
              <figure class="sg-swatch">
                <span class="sg-swatch__chip" style={`background:var(${t.name})`} />
                <figcaption>
                  <code>{t.name}</code>
                </figcaption>
              </figure>
            ))
          }
        </div>

        <h3 class="sg-subtitle">Accentthema's (<code>data-accent</code>)</h3>
        <p class="sg-note">
          Per doelgroep wisselt de accentkleur: events oranje, artiesten geel, zakelijke events groen. Componenten gebruiken
          <code>--accent</code>, <code>--accent-light</code> en <code>--accent-gradient</code>.
        </p>
        <div class="sg-row">
          {
            accents.map((accent) => (
              <div class="sg-accent" data-accent={accent}>
                <code>data-accent="{accent}"</code>
                <Heading as="p" size="h3" text="Bold in." gradient="accent" flush />
                <Button label="Bold to action" variant="primary" size="small" />
              </div>
            ))
          }
        </div>
      </section>

      <!-- ─── Typografie ──────────────────────────────────────────── -->
      <section class="sg-section" id="typografie">
        <h2 class="sg-title">Typografie</h2>
        <table class="sg-table">
          <tbody>
            {
              [...families, ...weights].map((t) => (
                <tr>
                  <td>
                    <code>{t.name}</code>
                  </td>
                  <td>{t.value}</td>
                  <td>{t.comment}</td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <div class="sg-fonts">
          <p class="sg-font-sample" style="font-family:var(--font-display)">Gate 400 — Video's die je event</p>
          <p class="sg-font-sample" style="font-family:var(--font-display);font-style:italic">Gate 400 italic — laten leven</p>
          <p class="sg-font-sample" style="font-family:var(--font-body);font-weight:var(--fw-light)">Inter 300 — Je event moet slagen.</p>
          <p class="sg-font-sample" style="font-family:var(--font-body);font-weight:var(--fw-medium)">Inter 500 — Bold to action</p>
          <p class="sg-font-sample" style="font-family:var(--font-body);font-weight:var(--fw-bold)">Inter 700 — Offerte aanvragen</p>
        </div>

        <h3 class="sg-subtitle">Schaal</h3>
        <div class="sg-scale">
          {
            fontSizes.map((t) => (
              <div class="sg-scale__row">
                <div class="sg-scale__meta">
                  <code>{t.name}</code>
                  <span>{t.value}</span>
                </div>
                <p class="sg-scale__sample" style={`font-size:var(${t.name})`}>
                  Bold in. Sold out.
                </p>
              </div>
            ))
          }
        </div>

        <h3 class="sg-subtitle">Regelhoogtes en letterspatiëring</h3>
        <table class="sg-table">
          <tbody>
            {
              [...lineHeights, ...letterSpacings].map((t) => (
                <tr>
                  <td>
                    <code>{t.name}</code>
                  </td>
                  <td>{t.value}</td>
                  <td>{t.comment}</td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <h3 class="sg-subtitle">RichText (<code>lib/rich.ts</code>)</h3>
        <p class="sg-note">
          <code>&lt;RichText content size plain /&gt;</code>. Model: blokken <code>{'{ p: [...] }'}</code> en
          <code>{'{ ul: [[...]] }'}</code>, inline <code>'tekst'</code>, <code>{'{ text, strong, em }'}</code>,
          <code>{'{ br: true }'}</code>.
        </p>
        <RichText
          size="lead"
          class="sg-richtext"
          content={[
            { p: ['Een alinea met ', { text: 'strong', strong: true }, ', ', { text: 'em', em: true }, ' en', { br: true }, 'een regeleinde.'] },
            { ul: [['Lijstitem met oranje driehoek'], ['Tweede item']] },
          ]}
        />
        <p class="sg-note">Handgeschreven HTML met <code>.rich-text</code> werkt ook:</p>
        <div class="rich-text rich-text--lead sg-richtext">
          <p>
            Bold Productions weet <strong>wat</strong> je <strong>wanneer</strong> moet laten zien. En vooral <strong
              >hóe</strong
            > je het laat zien.
          </p>
          <ul>
            <li>tickets verkopen;</li>
            <li>sponsoren en partners overtuigen;</li>
            <li>en bezoekers laten terugkomen.</li>
          </ul>
        </div>
      </section>

      <!-- ─── Spacing ─────────────────────────────────────────────── -->
      <section class="sg-section" id="spacing">
        <h2 class="sg-title">Spacing</h2>
        <div class="sg-spacing">
          {
            spacing.map((t) => (
              <div class="sg-spacing__row">
                <code>{t.name}</code>
                <span class="sg-spacing__bar" style={`width:var(${t.name})`} />
                <span>{t.value}</span>
              </div>
            ))
          }
        </div>
        <h3 class="sg-subtitle">Layout (responsive)</h3>
        <table class="sg-table">
          <tbody>
            {
              layout.map((t) => (
                <tr>
                  <td>
                    <code>{t.name}</code>
                  </td>
                  <td>{t.value}</td>
                  <td>{t.comment}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="sg-note">
          Breakpoints (Webflow, desktop-first): ≤991, ≤767, ≤479 en ≥1280, ≥1440, ≥1920. Containerbreedte: 940 → 1140 →
          1320 → 1680, tablet 720, mobiel volle breedte.
        </p>
      </section>

      <!-- ─── Vormen ──────────────────────────────────────────────── -->
      <section class="sg-section" id="vormen">
        <h2 class="sg-title">Radii, schaduwen & blur</h2>
        <div class="sg-row">
          {
            radii.map((t) => (
              <figure class="sg-shape" style={t.name.startsWith('--radius') ? `border-radius:var(${t.name})` : undefined}>
                <figcaption>
                  <code>{t.name}</code>
                  <span>{t.value}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
        <div class="sg-row">
          {
            shadows.map((t) => (
              <figure class="sg-shape sg-shape--light" style={`box-shadow:var(${t.name})`}>
                <figcaption>
                  <code>{t.name}</code>
                </figcaption>
              </figure>
            ))
          }
        </div>
        <div class="sg-row">
          {
            blurs.map((t) => (
              <figure class="sg-shape sg-shape--glass" style={`backdrop-filter:blur(var(${t.name}))`}>
                <figcaption>
                  <code>{t.name}</code>
                  <span>{t.value}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <!-- ─── Overig ──────────────────────────────────────────────── -->
      <section class="sg-section" id="overig">
        <h2 class="sg-title">Overige tokens</h2>
        <table class="sg-table">
          <tbody>
            {
              [...sizes, ...motion, ...layers].map((t) => (
                <tr>
                  <td>
                    <code>{t.name}</code>
                  </td>
                  <td>{t.value}</td>
                  <td>{t.comment}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>

      <!-- ─── Cursor & animaties ──────────────────────────────────── -->
      <section class="sg-section" id="beweging">
        <h2 class="sg-title">Cursor & animaties</h2>
        <p class="sg-note">
          Cursor: oranje driehoekje (<code>--cursor-default</code>), op links en knoppen wit
          (<code>--cursor-pointer</code>). Alleen met een muis; op touch de gewone systeemcursor. Cookiepanelen en
          <code>[data-native-cursor]</code> krijgen de systeemcursor.
        </p>
        <div class="sg-row sg-row--center">
          <Button label="Hover mij" href="#beweging" />
          <span class="sg-label" data-native-cursor>Hier de systeemcursor (data-native-cursor)</span>
        </div>
        <p class="sg-note sg-note--spaced">
          <code>data-animate</code>: element schuift in als geheel. <code>data-animate-stagger</code>: de directe
          kinderen komen één voor één binnen (<code>--stagger-step</code>); <code>data-animate-skip</code> op een kind
          laat het buiten de reeks.
        </p>
        <p class="sg-note sg-note--spaced">
          Paginaovergang: shutter. Tien zwarte stroken: per strook groeit een balk van boven naar beneden, onderste eerst, tot het scherm dicht is; daarna krimpen ze in dezelfde volgorde terug en staat de nieuwe pagina eronder (<code>--duration-page-shutter</code>). Native View Transitions, alleen CSS; Firefox laadt gewoon de pagina, reduced motion krijgt een crossfade. Probeer: <a href="/">naar de homepage</a>.
        </p>
        <div class="sg-row" data-animate-stagger>
          <span class="sg-label">Eén</span>
          <span class="sg-label">Twee</span>
          <span class="sg-label">Drie</span>
          <span class="sg-label">Vier</span>
        </div>
      </section>

      <!-- ─── Button ──────────────────────────────────────────────── -->
      <section class="sg-section" id="button">
        <h2 class="sg-title">Button</h2>
        <p class="sg-note">
          <code>&lt;Button label href variant size accent icon iconOnlyOnMobile /&gt;</code>. Kapitalen in de body-font, geen
          gradient. Varianten: primary (accentvlak, bij hover zwart), outline (accentrand, bij hover accentvlak), ghost
          (donker glas, bij hover wit). De vulling veegt bij hover van links naar rechts, bij een pijl omlaag
          (<code>icon="arrow-down"</code>) van boven naar onder. Groottes: small (48), default (64), large (64 → 56 op
          mobiel).
        </p>
        {
          accents.map((accent) => (
            <div class="sg-demo" data-accent={accent}>
              <p class="sg-label">accent: {accent}</p>
              {variants.map((variant) => (
                <div class="sg-row sg-row--center">
                  {buttonSizes.map((size) => (
                    <Button label={`${variant} / ${size}`} href="#button" variant={variant} size={size} />
                  ))}
                </div>
              ))}
            </div>
          ))
        }
        <div class="sg-demo">
          <p class="sg-label">Iconen en gebruik op de homepage</p>
          <div class="sg-row sg-row--center">
            <Button label="Bold to action" href="#button" size="large" />
            <Button label="Waarom zou je?" href="#button" variant="outline" size="large" icon="arrow-down" />
            <Button label="Bekijk hoe" href="#button" variant="ghost" />
            <Button label="Make it Bold. Sell Tickets" href="#button" accent="yellow" />
            <Button label="Mail Mike" href="#button" accent="yellow" />
            <Button label="Menu" variant="ghost" size="small" icon="menu" iconOnlyOnMobile />
            <Button label="Zonder icoon" href="#button" variant="ghost" icon={null} />
          </div>
        </div>
      </section>

      <!-- ─── Icon ────────────────────────────────────────────────── -->
      <section class="sg-section" id="icon">
        <h2 class="sg-title">Icon</h2>
        <p class="sg-note">
          <code>&lt;Icon name size label /&gt;</code>. Kleur via <code>currentColor</code>. Zonder <code>label</code>
          decoratief (aria-hidden).
        </p>
        <div class="sg-icons">
          {
            iconNames.map((name) => (
              <figure class="sg-icon">
                <Icon name={name} size="var(--icon-xl)" />
                <figcaption>
                  <code>{name}</code>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <!-- ─── Eyebrow & Heading ───────────────────────────────────── -->
      <section class="sg-section" id="tekst">
        <h2 class="sg-title">Eyebrow & Heading</h2>
        <div class="sg-demo">
          <p class="sg-label">Eyebrow</p>
          <Eyebrow text="Ervoor. Tijdens. Erna" />
        </div>
        <div class="sg-demo sg-stack">
          <p class="sg-label">Heading — groottes (as/size los van elkaar). hero en h1: kapitalen met gradient; h2–h6: gewone hoofdletters, h2 met lijn, h3 in de kleur</p>
          <Heading as="p" size="hero" text="Video's die je event" />
          <Heading as="p" size="h1" text="Heading h1" flush />
          <Heading as="p" size="h2" text="Heading h2" flush />
          <Heading as="p" size="h3" text="Heading h3" flush />
          <Heading as="p" size="h4" text="Heading h4" flush />
          <Heading as="p" size="h5" text="Heading h5" flush />
          <Heading as="p" size="h6" text="Heading h6" flush />
        </div>
        <div class="sg-demo sg-stack">
          <p class="sg-label">Heading — gradients en regeleinden (\n)</p>
          <Heading as="p" size="h2" text={'BOLD IN.\nSOLD OUT.'} gradient="yellow" flush />
          <Heading as="p" size="h2" text="En dit vonden ze" gradient="orange" flush />
          <Heading as="p" size="h2" text="We kennen onze plek" gradient="green" flush />
          <Heading as="p" size="h3" text="Voor je event" gradient="yellow" flush />
        </div>
      </section>

      <!-- ─── SectionHeading ──────────────────────────────────────── -->
      <section class="sg-section" id="section-heading">
        <h2 class="sg-title">SectionHeading</h2>
        <div class="sg-demo">
          <SectionHeading eyebrow="Dit deden we" title="En dit vonden ze" gradient="orange" />
          <SectionHeading eyebrow="Bold backstage" title="We kennen onze plek" gradient="green" spacing="none" />
        </div>
      </section>

      <!-- ─── Container ───────────────────────────────────────────── -->
      <section class="sg-section" id="container">
        <h2 class="sg-title">Container</h2>
        <p class="sg-note">Rand = binnenkant van de container (inclusief goot).</p>
      </section>
    </Container>

    <div class="sg-container-demo">
      <Container>
        <div class="sg-container-demo__inner"><code>width="default"</code></div>
      </Container>
      <Container width="wide">
        <div class="sg-container-demo__inner"><code>width="wide"</code></div>
      </Container>
    </div>

    <Container>
      <!-- ─── Layout ──────────────────────────────────────────────── -->
      <section class="sg-section" id="layout">
        <h2 class="sg-title">Layout</h2>
        <p class="sg-note">
          <code>Header</code> (met <code>MegaMenu</code> en <code>MenuPanel</code>). De dropdowns verschijnen vanaf 1280px bij
          hover of focus. De menuknop opent het paneel; dit kader houdt de vaste header, het paneel en de
          <code>WhatsAppButton</code> binnen de demo. <code>PageBackground</code> (textuur + B-vormen) staat om elke
          pagina heen via <code>BaseLayout</code>; de textuur zie je ook achter deze styleguide.
        </p>
      </section>
    </Container>
    <div class="sg-frame">
      <Header
        nav={navigation.events.nav}
        cta={navigation.events.cta}
        home={navigation.events.home}
        menuLabel={header.menuLabel}
        logoAlt={header.logoAlt}
        homeTitle={header.homeTitle}
        currentPath="/events/organisatoren"
      />
      <WhatsAppButton href={contact.whatsapp.href} label={contact.whatsapp.label} />
    </div>

    <Container>
      <p class="sg-note sg-note--spaced">
        Neutrale pagina's (juridisch, sitemap, 404, landingspagina's, homepage): geen menu, alleen de knoppen
        <code>buttons</code> (Bold Events / Bold Business). Op de homepage met <code>revealAfter="[data-split-hero]"</code>:
        de balk verschijnt pas na de split-hero.
      </p>
    </Container>
    <div class="sg-frame">
      <Header
        nav={navigation.neutral.nav}
        buttons={navigation.neutral.buttons}
        home={navigation.neutral.home}
        menuLabel={header.menuLabel}
        logoAlt={header.logoAlt}
        homeTitle={header.homeTitle}
        currentPath="/algemene-voorwaarden"
      />
    </div>

    <Container>
      <p class="sg-note sg-note--spaced">
        <code>&lt;Breadcrumbs items homeLabel label /&gt;</code>: kruimelpad onder de hero; laatste item = huidige pagina.
      </p>
    </Container>
    <Breadcrumbs
      items={[{ label: 'Events', href: '/events/organisatoren' }, { label: 'Aftermovie' }]}
      homeLabel={breadcrumbLabels.home}
      label={breadcrumbLabels.nav}
    />

    <Container>
      <p class="sg-note sg-note--spaced"><code>Footer</code>: kolommen, contact, logo en socials, juridische links.</p>
    </Container>
    <Footer
      columns={navigation.events.footer}
      contact={contact}
      socials={socials}
      legalLinks={legalLinks}
      copyright={copyright}
      logoAlt={footerLogoAlt}
    />

    <Container>
      <!-- ─── Secties ─────────────────────────────────────────────── -->
      <section class="sg-section" id="secties">
        <h2 class="sg-title">Secties</h2>
        <h3 class="sg-subtitle">Hero</h3>
        <p class="sg-note">
          <code>&lt;Hero title titleAccent eyebrow primaryCta secondaryCta image video accent /&gt;</code>. Hieronder de
          homepage-props zonder video, met <code>accent="yellow"</code>. De video (Vimeo) laadt na window.load en fadet in
          zodra hij speelt.
        </p>
      </section>
    </Container>
    <div class="sg-frame sg-frame--section">
      <Hero {...hero} video={undefined} accent="yellow" />
    </div>

    <Container>
      <h3 class="sg-subtitle">SplitHero</h3>
      <p class="sg-note">
        <code>&lt;SplitHero title halves /&gt;</code>: homepage, keuze tussen Events en Business. Per helft titel, tekst,
        knop (de hele helft is de link), <code>accent</code>, foto en optioneel Vimeo. ≥1280 groeit de helft onder de muis
        (60/40), gloeit de naad in haar kleur en speelt de video (na window.load); ≤1279 onder elkaar. Logo = h1.
      </p>
    </Container>
    <div class="sg-frame sg-frame--section">
      {splitHero && <SplitHero {...splitHero} />}
    </div>

    <Container>
      <h3 class="sg-subtitle">LogoMarquee</h3>
      <p class="sg-note">
        <code>&lt;LogoMarquee title logos /&gt;</code>. Logo's: <code>{'{ src, alt }'}</code> met de organisatienaam als
        alt. Raster via Picture (AVIF/WebP), SVG direct. Pure CSS-marquee, stil bij reduced motion.
      </p>
    </Container>
    <LogoMarquee {...trustedBy} />

    <Container>
      <h3 class="sg-subtitle">IntroHighlight</h3>
      <p class="sg-note">
        <code>&lt;IntroHighlight id content /&gt;</code>. <code>content</code> is rich text (<code>lib/rich.ts</code>);
        <code>strong</code> wordt groen. Letters lichten op bij scrollen (<code>scroll-highlight.ts</code>).
      </p>
    </Container>
    <IntroHighlight content={intro.content} />

    <Container>
      <h3 class="sg-subtitle">Timeline</h3>
      <p class="sg-note">
        <code>&lt;Timeline title intro steps cta gradient reverse /&gt;</code>. Stappen: foto (16:9) + tekstblok met
        rookvideo, afwisselend foto links/rechts; <code>reverse</code> begint met de foto rechts. Voorbeeld met twee
        stappen, <code>reverse</code> en groene gradient:
      </p>
    </Container>
    <Timeline {...timeline} steps={timeline.steps.slice(0, 2)} reverse gradient="green" cta={{ ...timeline.cta!, accent: 'green' }} />

    <Container>
      <h3 class="sg-subtitle">BackgroundVideo (ui)</h3>
      <p class="sg-note">
        <code>&lt;BackgroundVideo src layer opacity /&gt;</code>. Poster als AVIF/WebP; video laadt en speelt pas in beeld.
      </p>
      <div class="sg-video-demo"><BackgroundVideo layer="overlay" /></div>

      <h3 class="sg-subtitle">TestimonialCard (ui)</h3>
      <p class="sg-note">
        <code>&lt;TestimonialCard quote name organisation image /&gt;</code>. Naam of organisatie mag ontbreken; dan
        vervalt het streepje.
      </p>
      <div class="sg-row">
        <div class="sg-card-demo"><TestimonialCard {...testimonials.items[1]!} /></div>
        <div class="sg-card-demo"><TestimonialCard {...testimonials.items[0]!} /></div>
        <div class="sg-card-demo"><TestimonialCard {...testimonials.items[4]!} /></div>
      </div>

      <h3 class="sg-subtitle">Testimonials + Carousel</h3>
      <p class="sg-note">
        <code>&lt;Testimonials eyebrow title gradient items carousel /&gt;</code>. De <code>Carousel</code> (ui) gebruikt
        scroll-snap: 1/1/2/3 items, peek op mobiel, items blijven buiten de container zichtbaar.
      </p>
    </Container>
    <Testimonials {...testimonials} />

    <Container>
      <h3 class="sg-subtitle">Polaroid (ui) + PolaroidStack</h3>
      <p class="sg-note">
        <code>&lt;Polaroid src alt caption /&gt;</code> en <code>&lt;PolaroidStack eyebrow title gradient photos /&gt;</code>.
        Kanteling per positie; de foto's schuiven sticky over elkaar.
      </p>
      <div class="sg-row">
        <div class="sg-polaroid-demo" style="--polaroid-rotate:-1.5deg">
          <Polaroid {...backstage.photos[0]!} caption="Voorbeeldcaption" sizes="320px" />
        </div>
      </div>
    </Container>
    <PolaroidStack {...backstage} photos={backstage.photos.slice(0, 3)} />

    <Container>
      <h3 class="sg-subtitle">TextMedia (+ VimeoEmbed, DecoTriangles)</h3>
      <p class="sg-note">
        <code>&lt;TextMedia id title gradient body cta media reverse triangles /&gt;</code>. <code>media</code>: Vimeo
        (lazy iframe) of afbeelding. Voorbeeld: <code>reverse</code> en <code>id="cinema"</code>, dus beweeg de muis
        over deze sectie voor de popcorn-cursor.
      </p>
    </Container>
    <TextMedia {...micDrop} id="cinema" reverse gradient="orange" cta={{ ...micDrop.cta!, accent: 'orange' }} />

    <Container>
      <p class="sg-note">
        Variant met afbeelding (staand 2:3), <code>reverse</code> en <code>spacing="section"</code> (events):
      </p>
    </Container>
    <TextMedia {...biggerThanTheDay} id="sg-image-variant" />

    <Container>
      <p class="sg-note">
        Met <code>links</code> (ContactLinks: bellen, mailen, WhatsApp; icoon volgt het soort link), zoals "Mail Mike" op de
        homepage:
      </p>
    </Container>
    {mailMike && <TextMedia {...mailMike} id="sg-links-variant" />}

    <Container>
      <h3 class="sg-subtitle">CaseCard (ui) + CaseSpotlight</h3>
      <p class="sg-note">
        <code>&lt;CaseSpotlight title gradient caseSlug /&gt;</code> haalt de case uit <code>src/data/cases.ts</code>.
        <code>&lt;CaseCard item /&gt;</code> is de losse kaart (ook bruikbaar voor een casesoverzicht).
      </p>
    </Container>
    <CaseSpotlight {...caseSpotlight} />

    <Container>
      <h3 class="sg-subtitle">ImageFeature</h3>
      <p class="sg-note">
        <code>&lt;ImageFeature id title gradient text image /&gt;</code>: brede foto met gecentreerde tekst; op mobiel
        eronder. Hier zonder <code>id="cinema"</code> (die staat al op de TextMedia-demo).
      </p>
    </Container>
    <ImageFeature {...cinema} id={undefined} />

    <Container>
      <h3 class="sg-subtitle">ServiceTiles</h3>
      <p class="sg-note">
        <code>&lt;ServiceTiles title gradient text items /&gt;</code>: staande beeldtegels (2:3) die naar dienstpagina's
        linken. ≥1440 één rij met verspringing, daaronder 3 / 2 / 1 per rij.
      </p>
    </Container>
    <ServiceTiles {...services} />

    <Container>
      <h3 class="sg-subtitle">Faq</h3>
      <p class="sg-note">
        <code>&lt;Faq id title gradient items /&gt;</code>: accordeon (scripts/accordion.ts) met FAQPage-JSON-LD. Zonder
        JS staan de antwoorden open.
      </p>
    </Container>
    <Faq {...faq} id="sg-faq" items={faq.items.slice(0, 2)} />

    <Container>
      <h3 class="sg-subtitle">ContactForm (ui) in TextMedia</h3>
      <p class="sg-note">
        <code>&lt;TextMedia intro media …&gt;&lt;ContactForm slot="content" … /&gt;&lt;/TextMedia&gt;</code>. Velden en
        teksten uit <code>src/data/forms.ts</code>; endpoint via <code>PUBLIC_CONTACT_ENDPOINT</code> (TODO).
      </p>
    </Container>
    <TextMedia {...contactSection}>
      <ContactForm slot="content" {...contactForm} name="Contact styleguide" />
    </TextMedia>

    <Container>
      <h3 class="sg-subtitle">ServiceTiles — variant team</h3>
      <p class="sg-note">
        <code>&lt;ServiceTiles variant="team" items /&gt;</code>: teamleden (<code>src/data/team.ts</code>,
        <code>teamTiles()</code>) met naam en rol; bij hover speelt het korte video'tje (<code>hover-video.ts</code>).
      </p>
    </Container>
    <ServiceTiles {...teamExample.props} />

    <Container>
      <h3 class="sg-subtitle">RichTextSection</h3>
      <p class="sg-note">
        <code>&lt;RichTextSection id content align /&gt;</code>: smalle gecentreerde tekstkolom (dienst-, case- en juridische
        pagina's). Koppen krijgen de gradient, Vimeo-video's kunnen in de tekst staan.
      </p>
    </Container>
    <RichTextSection {...richTextExample.props} id="sg-richtext" />

    <Container>
      <h3 class="sg-subtitle">CaseFacts</h3>
      <p class="sg-note">
        <code>&lt;CaseFacts items /&gt;</code>: feitenbalk op een casepagina (klant, datum, doelgroep, diensten), gevuld met
        <code>caseFacts(case)</code> uit <code>lib/cases.ts</code>.
      </p>
    </Container>
    <CaseFacts {...caseFacts(cases[0]!)} />

    <Container>
      <h3 class="sg-subtitle">FullWidthImage</h3>
      <p class="sg-note"><code>&lt;FullWidthImage image /&gt;</code>: 16:9-foto over de containerbreedte.</p>
    </Container>
    <FullWidthImage {...fullWidthImageExample.props} />

    <Container>
      <h3 class="sg-subtitle">VideoFeature</h3>
      <p class="sg-note">
        <code>&lt;VideoFeature video ratio /&gt;</code>: Vimeo (lazy iframe, met bediening) over de containerbreedte.
      </p>
    </Container>
    <VideoFeature {...videoFeatureExample.props} />

    <Container>
      <h3 class="sg-subtitle">CaseGrid</h3>
      <p class="sg-note">
        <code>&lt;CaseGrid filters items emptyText label /&gt;</code>, props via <code>caseGridProps(cases, 'events')</code>. Filteren in
        <code>case-filter.ts</code>; <code>?filter=events</code> kiest vooraf een doelgroep. Hier vier cases.
      </p>
    </Container>
    <CaseGrid {...caseGridProps(cases.slice(0, 4), 'events')} id="sg-casegrid" />

    <Container>
      <h3 class="sg-subtitle">ContactSection (+ ContactForm)</h3>
      <p class="sg-note">
        <code>&lt;ContactSection id content links formWidth&gt;&lt;ContactForm slot="form" … /&gt;&lt;/ContactSection&gt;</code>:
        tekst met bel-, mail- en WhatsApp-link naast het formulier (contact, offerte, trouwfilm; met meerkeuzevelden via
        <code>multiselect.ts</code>).
      </p>
    </Container>
    <ContactSection {...contactSectionExample.props} id="sg-contact">
      <ContactForm slot="form" {...getForm(contactSectionExample.form)} name="Contact styleguide 2" />
    </ContactSection>

    <Container>
      <h3 class="sg-subtitle">MapSection</h3>
      <p class="sg-note">
        <code>&lt;MapSection title gradient text src label /&gt;</code>: Google Maps-iframe, lazy geladen.
      </p>
    </Container>
    <MapSection {...mapExample.props} />

    <Container>
      <h3 class="sg-subtitle">LinkGroups</h3>
      <p class="sg-note">
        <code>&lt;LinkGroups eyebrow title titleAs gradient groups /&gt;</code>: kaarten met links per groep (sitemap).
        Een groep met <code>auto: 'cases'</code> wordt gevuld met alle cases. Hier drie groepen, kop als h2.
      </p>
    </Container>
    <LinkGroups {...linkGroupsExample.props} titleAs="h2" groups={linkGroupsExample.props.groups.slice(0, 3)} />
  </div>
</BaseLayout>

