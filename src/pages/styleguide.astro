---
/**
 * /styleguide — levend overzicht van tokens, UI-componenten en secties.
 * Regel: elk nieuw component of elke nieuwe variant komt eerst hier.
 * noindex; hoort niet in de sitemap.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { iconNames } from '../components/ui/icons';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Heading from '../components/ui/Heading.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { tokensByPrefix } from '../lib/tokens';
import Header from '../components/layout/Header.astro';
import WhatsAppButton from '../components/layout/WhatsAppButton.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import { breadcrumbLabels, contact, copyright, cta, footerColumns, footerLogoAlt, header, legalLinks, mainNav, socials } from '../data/navigation';
import Hero from '../components/sections/Hero.astro';
import LogoMarquee from '../components/sections/LogoMarquee.astro';
import IntroHighlight from '../components/sections/IntroHighlight.astro';
import RichText from '../components/ui/RichText.astro';
import Timeline from '../components/sections/Timeline.astro';
import BackgroundVideo from '../components/ui/BackgroundVideo.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import TestimonialCard from '../components/ui/TestimonialCard.astro';
import PolaroidStack from '../components/sections/PolaroidStack.astro';
import Polaroid from '../components/ui/Polaroid.astro';
import TextMedia from '../components/sections/TextMedia.astro';
import { backstage, hero, intro, micDrop, testimonials, timeline, trustedBy } from '../data/home';
import CaseSpotlight from '../components/sections/CaseSpotlight.astro';
import ImageFeature from '../components/sections/ImageFeature.astro';
import ServiceTiles from '../components/sections/ServiceTiles.astro';
import Faq from '../components/sections/Faq.astro';
import ContactForm from '../components/ui/ContactForm.astro';
import { contactForm } from '../data/forms';
import { biggerThanTheDay, caseSpotlight, cinema, contactSection, faq, services } from '../data/events';
import RichTextSection from '../components/sections/RichTextSection.astro';
import FullWidthImage from '../components/sections/FullWidthImage.astro';
import VideoFeature from '../components/sections/VideoFeature.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import MapSection from '../components/sections/MapSection.astro';
import CaseGrid from '../components/sections/CaseGrid.astro';
import CaseFacts from '../components/sections/CaseFacts.astro';
import LinkGroups from '../components/sections/LinkGroups.astro';
import { getForm } from '../data/forms';
import { pages } from '../data/pages';
import { cases, caseGridProps } from '../data/cases';
import { caseFacts } from '../lib/cases';
import type { PageSection } from '../lib/sections';

const colors = tokensByPrefix('--color-');
const gradients = tokensByPrefix('--gradient-');
const fontSizes = tokensByPrefix('--fs-');
const lineHeights = tokensByPrefix('--lh-');
const letterSpacings = tokensByPrefix('--ls-');
const families = tokensByPrefix('--font-');
const weights = tokensByPrefix('--fw-');
const spacing = tokensByPrefix('--space-');
const layout = tokensByPrefix('--section-', '--column-', '--row-', '--container-', '--navbar-');
const sizes = tokensByPrefix('--button-', '--icon-', '--carousel-', '--whatsapp-', '--logo-', '--hero-');
const radii = tokensByPrefix('--radius-', '--border-');
const shadows = tokensByPrefix('--shadow-');
const blurs = tokensByPrefix('--blur-');
const motion = tokensByPrefix('--duration-', '--ease-', '--marquee-');
const layers = tokensByPrefix('--z-');

/** Voorbeeldprops uit de echte pagina-inhoud (src/data/pages + cases): eerste sectie van dat type. */
const allSections: PageSection[] = [...pages.flatMap((p) => p.sections), ...cases.flatMap((c) => c.sections ?? [])];
function example<T extends PageSection['type']>(type: T) {
  const found = allSections.find((s): s is Extract<PageSection, { type: T }> => s.type === type);
  if (!found) throw new Error(`Geen voorbeeld voor sectie '${type}' in src/data`);
  return found;
}
const richTextExample = example('richText');
const fullWidthImageExample = example('fullWidthImage');
const videoFeatureExample = example('videoFeature');
const contactSectionExample = example('contactSection');
const mapExample = example('map');
const linkGroupsExample = example('linkGroups');
const teamExample = allSections.find((s) => s.type === 'serviceTiles' && s.props.variant === 'team') as Extract<PageSection, { type: 'serviceTiles' }>;

const accents = ['orange', 'yellow', 'green'] as const;
const variants = ['primary', 'outline', 'ghost'] as const;
const buttonSizes = ['small', 'default', 'large'] as const;

const nav = [
  ['kleuren', 'Kleuren'],
  ['typografie', 'Typografie'],
  ['spacing', 'Spacing'],
  ['vormen', 'Radii, schaduwen & blur'],
  ['overig', 'Overige tokens'],
  ['button', 'Button'],
  ['icon', 'Icon'],
  ['tekst', 'Eyebrow & Heading'],
  ['section-heading', 'SectionHeading'],
  ['container', 'Container'],
  ['layout', 'Layout'],
  ['knop-voorstellen', 'Knop: 6 voorstellen'],
  ['kop-voorstellen', 'Koppen: 6 voorstellen'],
  ['secties', 'Secties'],
];

/** Kopvoorstellen (#kop-voorstellen) voor h2–h6 (hero-h1 blijft): alleen hier gestyled, via .sg-hlook--{id}. */
const headingLooks = [
  {
    id: 1,
    name: 'Rustig & effen',
    text: 'Zelfde kapitalen, maar met lucht: regelafstand 100% in plaats van 88%, effen accentkleur in plaats van de gradient. h4–h6 worden kleine, gespatieerde labels (zoals de eyebrow), zodat de hiërarchie duidelijker is.',
  },
  {
    id: 2,
    name: 'Gewone hoofdletters',
    text: 'Geen kapitalen meer onder de hero: koppen in gewone zinsopbouw, wit, met een kort accentlijntje onder de h2. Leest rustiger en moderner; de hero blijft het schreeuwende moment.',
  },
  {
    id: 3,
    name: 'Neon-outline',
    text: 'h2 als lijnletter in de accentkleur met een zachte gloed, net als de neon B-vormen op de achtergrond. h3 gevuld wit, h4–h6 in accentkleur. Het meest uitgesproken.',
  },
  {
    id: 4,
    name: 'Cursief accent',
    text: 'h2 in Gate italic (de letter van de accentregel in de hero) in effen accentkleur; h3 recht en wit. Zo voelt elke sectie als een vervolg op de hero.',
  },
  {
    id: 5,
    name: 'Driehoekmarker',
    text: 'Witte kapitalen met een oranje driehoekje ervoor: hetzelfde motief als de driehoekjes rond de foto’s. h3–h6 in accentkleur, zonder gradient.',
  },
  {
    id: 6,
    name: 'Redactioneel',
    text: 'Grote witte h2 met een verticale accentbalk ervoor, zoals in een magazine. Meer contrast tussen de niveaus: h3 compact in accentkleur, h4–h6 wit in gewone zinsopbouw.',
  },
] as const;

/** Knopvoorstellen (#knop-voorstellen): alleen hier gestyled, via .sg-look--{id}. */
const looks = [
  {
    id: 1,
    name: 'Vullen van onder',
    text: 'Effen knop met een dikke accentrand aan de onderkant, als een podiumrand. Bij hover loopt de vulling van onder naar boven vol (wit bij solid, accentkleur bij outline). Strak en rustig, met een duidelijke reactie.',
  },
  {
    id: 2,
    name: 'Neon',
    text: "Effen accentkleur met een zachte gloed, zoals de neon B's op de achtergrond. Outline: dunne lijn, gloeiende tekst. Bij hover gaat de gloed harder aan, als een lamp. Sluit aan bij concert- en festivalsfeer.",
  },
  {
    id: 3,
    name: 'Gate caps + veeg',
    text: 'Label in Gate (de displayletter van de koppen) in kapitalen met ruime spatiëring, dikkere rand. Bij hover veegt de vulling van links naar rechts in. Meest typografisch, past bij de eyebrows.',
  },
  {
    id: 4,
    name: 'Zoeker',
    text: 'Vier hoekjes rond de knop, zoals de zoeker van een camera: past bij een videoproductiebedrijf. Bij hover schuiven de hoekjes naar de knop toe en knippert er een rood REC-bolletje. Speels, maar alleen met effen vlakken.',
  },
  {
    id: 5,
    name: 'Pil + icoonbol',
    text: 'Afgeronde pil in effen accentkleur, met de pijl in een eigen rondje dat bij hover een kwartslag draait. Moderner en vriendelijker; het grootste contrast met de huidige hoekige stijl.',
  },
  {
    id: 6,
    name: 'Harde schaduw',
    text: 'Effen vlak met een harde, verschoven schaduw (posterstijl). Bij hover wordt de knop "ingedrukt" in zijn schaduw. Brutaal en tastbaar; valt het meest op.',
  },
] as const;
---

<BaseLayout
  title="Styleguide | Bold Productions"
  description="Interne styleguide met design tokens en componenten."
  noindex
  chrome={false}
>
  <div class="sg">
    <Container>
      <header class="sg-intro">
        <Eyebrow text="Bold Productions" />
        <Heading as="h1" size="h1" text="Styleguide" gradient="orange" flush />
        <p>
          Tokens komen rechtstreeks uit <code>src/styles/tokens.css</code>. Nieuwe componenten en varianten komen eerst
          hier, daarna pas op een pagina.
        </p>
        <nav class="sg-nav" aria-label="Styleguide-onderdelen">
          {nav.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
        </nav>
      </header>

      <!-- ─── Kleuren ─────────────────────────────────────────────── -->
      <section class="sg-section" id="kleuren">
        <h2 class="sg-title">Kleuren</h2>
        <div class="sg-swatches">
          {
            colors.map((t) => (
              <figure class="sg-swatch">
                <span class="sg-swatch__chip" style={`background:var(${t.name})`} />
                <figcaption>
                  <code>{t.name}</code>
                  <span>{t.value}</span>
                  {t.comment && <small>{t.comment}</small>}
                </figcaption>
              </figure>
            ))
          }
        </div>

        <h3 class="sg-subtitle">Gradients</h3>
        <div class="sg-swatches sg-swatches--wide">
          {
            gradients.map((t) => (
              <figure class="sg-swatch">
                <span class="sg-swatch__chip" style={`background:var(${t.name})`} />
                <figcaption>
                  <code>{t.name}</code>
                </figcaption>
              </figure>
            ))
          }
        </div>

        <h3 class="sg-subtitle">Accentthema's (<code>data-accent</code>)</h3>
        <p class="sg-note">
          Per doelgroep wisselt de accentkleur: events oranje, artiesten geel, zakelijke events groen. Componenten gebruiken
          <code>--accent</code>, <code>--accent-light</code> en <code>--accent-gradient</code>.
        </p>
        <div class="sg-row">
          {
            accents.map((accent) => (
              <div class="sg-accent" data-accent={accent}>
                <code>data-accent="{accent}"</code>
                <Heading as="p" size="h3" text="Bold in." gradient="accent" flush />
                <Button label="Bold to action" variant="primary" size="small" />
              </div>
            ))
          }
        </div>
      </section>

      <!-- ─── Typografie ──────────────────────────────────────────── -->
      <section class="sg-section" id="typografie">
        <h2 class="sg-title">Typografie</h2>
        <table class="sg-table">
          <tbody>
            {
              [...families, ...weights].map((t) => (
                <tr>
                  <td>
                    <code>{t.name}</code>
                  </td>
                  <td>{t.value}</td>
                  <td>{t.comment}</td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <div class="sg-fonts">
          <p class="sg-font-sample" style="font-family:var(--font-display)">Gate 400 — Video's die je event</p>
          <p class="sg-font-sample" style="font-family:var(--font-display);font-style:italic">Gate 400 italic — laten leven</p>
          <p class="sg-font-sample" style="font-family:var(--font-body);font-weight:var(--fw-light)">Inter 300 — Je event moet slagen.</p>
          <p class="sg-font-sample" style="font-family:var(--font-body);font-weight:var(--fw-medium)">Inter 500 — Bold to action</p>
          <p class="sg-font-sample" style="font-family:var(--font-body);font-weight:var(--fw-bold)">Inter 700 — Offerte aanvragen</p>
        </div>

        <h3 class="sg-subtitle">Schaal</h3>
        <div class="sg-scale">
          {
            fontSizes.map((t) => (
              <div class="sg-scale__row">
                <div class="sg-scale__meta">
                  <code>{t.name}</code>
                  <span>{t.value}</span>
                </div>
                <p class="sg-scale__sample" style={`font-size:var(${t.name})`}>
                  Bold in. Sold out.
                </p>
              </div>
            ))
          }
        </div>

        <h3 class="sg-subtitle">Regelhoogtes en letterspatiëring</h3>
        <table class="sg-table">
          <tbody>
            {
              [...lineHeights, ...letterSpacings].map((t) => (
                <tr>
                  <td>
                    <code>{t.name}</code>
                  </td>
                  <td>{t.value}</td>
                  <td>{t.comment}</td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <h3 class="sg-subtitle">RichText (<code>lib/rich.ts</code>)</h3>
        <p class="sg-note">
          <code>&lt;RichText content size plain /&gt;</code>. Model: blokken <code>{'{ p: [...] }'}</code> en
          <code>{'{ ul: [[...]] }'}</code>, inline <code>'tekst'</code>, <code>{'{ text, strong, em }'}</code>,
          <code>{'{ br: true }'}</code>.
        </p>
        <RichText
          size="lead"
          class="sg-richtext"
          content={[
            { p: ['Een alinea met ', { text: 'strong', strong: true }, ', ', { text: 'em', em: true }, ' en', { br: true }, 'een regeleinde.'] },
            { ul: [['Lijstitem met oranje driehoek'], ['Tweede item']] },
          ]}
        />
        <p class="sg-note">Handgeschreven HTML met <code>.rich-text</code> werkt ook:</p>
        <div class="rich-text rich-text--lead sg-richtext">
          <p>
            Bold Productions weet <strong>wat</strong> je <strong>wanneer</strong> moet laten zien. En vooral <strong
              >hóe</strong
            > je het laat zien.
          </p>
          <ul>
            <li>tickets verkopen;</li>
            <li>sponsoren en partners overtuigen;</li>
            <li>en bezoekers laten terugkomen.</li>
          </ul>
        </div>
      </section>

      <!-- ─── Spacing ─────────────────────────────────────────────── -->
      <section class="sg-section" id="spacing">
        <h2 class="sg-title">Spacing</h2>
        <div class="sg-spacing">
          {
            spacing.map((t) => (
              <div class="sg-spacing__row">
                <code>{t.name}</code>
                <span class="sg-spacing__bar" style={`width:var(${t.name})`} />
                <span>{t.value}</span>
              </div>
            ))
          }
        </div>
        <h3 class="sg-subtitle">Layout (responsive)</h3>
        <table class="sg-table">
          <tbody>
            {
              layout.map((t) => (
                <tr>
                  <td>
                    <code>{t.name}</code>
                  </td>
                  <td>{t.value}</td>
                  <td>{t.comment}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="sg-note">
          Breakpoints (Webflow, desktop-first): ≤991, ≤767, ≤479 en ≥1280, ≥1440, ≥1920. Containerbreedte: 940 → 1140 →
          1320 → 1680, tablet 720, mobiel volle breedte.
        </p>
      </section>

      <!-- ─── Vormen ──────────────────────────────────────────────── -->
      <section class="sg-section" id="vormen">
        <h2 class="sg-title">Radii, schaduwen & blur</h2>
        <div class="sg-row">
          {
            radii.map((t) => (
              <figure class="sg-shape" style={t.name.startsWith('--radius') ? `border-radius:var(${t.name})` : undefined}>
                <figcaption>
                  <code>{t.name}</code>
                  <span>{t.value}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
        <div class="sg-row">
          {
            shadows.map((t) => (
              <figure class="sg-shape sg-shape--light" style={`box-shadow:var(${t.name})`}>
                <figcaption>
                  <code>{t.name}</code>
                </figcaption>
              </figure>
            ))
          }
        </div>
        <div class="sg-row">
          {
            blurs.map((t) => (
              <figure class="sg-shape sg-shape--glass" style={`backdrop-filter:blur(var(${t.name}))`}>
                <figcaption>
                  <code>{t.name}</code>
                  <span>{t.value}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <!-- ─── Overig ──────────────────────────────────────────────── -->
      <section class="sg-section" id="overig">
        <h2 class="sg-title">Overige tokens</h2>
        <table class="sg-table">
          <tbody>
            {
              [...sizes, ...motion, ...layers].map((t) => (
                <tr>
                  <td>
                    <code>{t.name}</code>
                  </td>
                  <td>{t.value}</td>
                  <td>{t.comment}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>

      <!-- ─── Cursor & animaties ──────────────────────────────────── -->
      <section class="sg-section" id="beweging">
        <h2 class="sg-title">Cursor & animaties</h2>
        <p class="sg-note">
          Cursor: oranje driehoekje (<code>--cursor-default</code>), op links en knoppen wit
          (<code>--cursor-pointer</code>). Alleen met een muis; op touch de gewone systeemcursor. Cookiepanelen en
          <code>[data-native-cursor]</code> krijgen de systeemcursor.
        </p>
        <div class="sg-row sg-row--center">
          <Button label="Hover mij" href="#beweging" />
          <span class="sg-label" data-native-cursor>Hier de systeemcursor (data-native-cursor)</span>
        </div>
        <p class="sg-note sg-note--spaced">
          <code>data-animate</code>: element schuift in als geheel. <code>data-animate-stagger</code>: de directe
          kinderen komen één voor één binnen (<code>--stagger-step</code>); <code>data-animate-skip</code> op een kind
          laat het buiten de reeks.
        </p>
        <p class="sg-note sg-note--spaced">
          Paginaovergang: zwart gordijn dat van onder naar boven over de pagina schuift en op de nieuwe pagina
          wegtrekt (<code>--duration-curtain</code> per fase, <code>--ease-curtain</code>). Native View Transitions,
          alleen CSS; Firefox en reduced motion laden gewoon de pagina. Probeer: <a href="/">naar de homepage</a>.
        </p>
        <div class="sg-row" data-animate-stagger>
          <span class="sg-label">Eén</span>
          <span class="sg-label">Twee</span>
          <span class="sg-label">Drie</span>
          <span class="sg-label">Vier</span>
        </div>
      </section>

      <!-- ─── Button ──────────────────────────────────────────────── -->
      <section class="sg-section" id="button">
        <h2 class="sg-title">Button</h2>
        <p class="sg-note">
          <code>&lt;Button label href variant size accent icon iconOnlyOnMobile /&gt;</code>. Varianten: primary (Webflow
          .orange/.yellow), outline (.orange-outline), ghost (.white-outline). Groottes: small (48), default (64), large (64
          → 56 op mobiel).
        </p>
        {
          accents.map((accent) => (
            <div class="sg-demo" data-accent={accent}>
              <p class="sg-label">accent: {accent}</p>
              {variants.map((variant) => (
                <div class="sg-row sg-row--center">
                  {buttonSizes.map((size) => (
                    <Button label={`${variant} / ${size}`} href="#button" variant={variant} size={size} />
                  ))}
                </div>
              ))}
            </div>
          ))
        }
        <div class="sg-demo">
          <p class="sg-label">Iconen en gebruik op de homepage</p>
          <div class="sg-row sg-row--center">
            <Button label="Bold to action" href="#button" size="large" />
            <Button label="Waarom zou je?" href="#button" variant="outline" size="large" icon="arrow-down" />
            <Button label="Bekijk hoe" href="#button" variant="ghost" />
            <Button label="Make it Bold. Sell Tickets" href="#button" accent="yellow" />
            <Button label="Mail Mike" href="#button" accent="yellow" />
            <Button label="Menu" variant="ghost" size="small" icon="menu" iconOnlyOnMobile />
            <Button label="Zonder icoon" href="#button" variant="ghost" icon={null} />
          </div>
        </div>
      </section>

      <!-- ─── Icon ────────────────────────────────────────────────── -->
      <section class="sg-section" id="icon">
        <h2 class="sg-title">Icon</h2>
        <p class="sg-note">
          <code>&lt;Icon name size label /&gt;</code>. Kleur via <code>currentColor</code>. Zonder <code>label</code>
          decoratief (aria-hidden).
        </p>
        <div class="sg-icons">
          {
            iconNames.map((name) => (
              <figure class="sg-icon">
                <Icon name={name} size="var(--icon-xl)" />
                <figcaption>
                  <code>{name}</code>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <!-- ─── Eyebrow & Heading ───────────────────────────────────── -->
      <section class="sg-section" id="tekst">
        <h2 class="sg-title">Eyebrow & Heading</h2>
        <div class="sg-demo">
          <p class="sg-label">Eyebrow</p>
          <Eyebrow text="Ervoor. Tijdens. Erna" />
        </div>
        <div class="sg-demo sg-stack">
          <p class="sg-label">Heading — groottes (as/size los van elkaar)</p>
          <Heading as="p" size="hero" text="Video's die je event" />
          <Heading as="p" size="h1" text="Heading h1" flush />
          <Heading as="p" size="h2" text="Heading h2" flush />
          <Heading as="p" size="h3" text="Heading h3" flush />
          <Heading as="p" size="h4" text="Heading h4" flush />
          <Heading as="p" size="h5" text="Heading h5" flush />
          <Heading as="p" size="h6" text="Heading h6" flush />
        </div>
        <div class="sg-demo sg-stack">
          <p class="sg-label">Heading — gradients en regeleinden (\n)</p>
          <Heading as="p" size="h2" text={'BOLD IN.\nSOLD OUT.'} gradient="yellow" flush />
          <Heading as="p" size="h2" text="En dit vonden ze" gradient="orange" flush />
          <Heading as="p" size="h2" text="We kennen onze plek" gradient="green" flush />
          <Heading as="p" size="h3" text="Voor je event" gradient="yellow" flush />
        </div>
      </section>

      <!-- ─── SectionHeading ──────────────────────────────────────── -->
      <section class="sg-section" id="section-heading">
        <h2 class="sg-title">SectionHeading</h2>
        <div class="sg-demo">
          <SectionHeading eyebrow="Dit deden we" title="En dit vonden ze" gradient="orange" />
          <SectionHeading eyebrow="Bold backstage" title="We kennen onze plek" gradient="green" spacing="none" />
        </div>
      </section>

      <!-- ─── Container ───────────────────────────────────────────── -->
      <section class="sg-section" id="container">
        <h2 class="sg-title">Container</h2>
        <p class="sg-note">Rand = binnenkant van de container (inclusief goot).</p>
      </section>
    </Container>

    <div class="sg-container-demo">
      <Container>
        <div class="sg-container-demo__inner"><code>width="default"</code></div>
      </Container>
      <Container width="wide">
        <div class="sg-container-demo__inner"><code>width="wide"</code></div>
      </Container>
    </div>

    <Container>
      <!-- ─── Layout ──────────────────────────────────────────────── -->
      <section class="sg-section" id="layout">
