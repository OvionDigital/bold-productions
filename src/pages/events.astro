---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import LogoMarquee from '../components/sections/LogoMarquee.astro';
import TextMedia from '../components/sections/TextMedia.astro';
import Timeline from '../components/sections/Timeline.astro';
import CaseSpotlight from '../components/sections/CaseSpotlight.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import ImageFeature from '../components/sections/ImageFeature.astro';
import ServiceTiles from '../components/sections/ServiceTiles.astro';
import Faq from '../components/sections/Faq.astro';
import ContactForm from '../components/ui/ContactForm.astro';
import { contactForm } from '../data/forms';
import { breadcrumbLabels } from '../data/navigation';
import {
  biggerThanTheDay,
  breadcrumbs,
  caseSpotlight,
  cinema,
  contact,
  faq,
  hero,
  meta,
  services,
  testimonials,
  timeline,
  trustedBy,
} from '../data/events';
---

<BaseLayout title={meta.title} description={meta.description}>
  <Hero {...hero} />
  <Breadcrumbs items={breadcrumbs} homeLabel={breadcrumbLabels.home} label={breadcrumbLabels.nav} />
  <LogoMarquee {...trustedBy} />
  <TextMedia {...biggerThanTheDay} />
  <Timeline {...timeline} />
  <CaseSpotlight {...caseSpotlight} />
  <Testimonials {...testimonials} />
  <ImageFeature {...cinema} />
  <ServiceTiles {...services} />
  <Faq {...faq} />
  <TextMedia {...contact}>
    <ContactForm slot="content" {...contactForm} />
  </TextMedia>
</BaseLayout>
