---
/**
 * Homepage: keuze tussen Bold Events en Bold Business (split-hero) en daaronder secties.
 * Inhoud = pagina 'home' uit Sanity, of src/data/pages/home.ts (lib/pages.ts). Neutraal
 * menu (knoppen Events/Business), pas zichtbaar na de split-hero. De vorige homepage staat op
 * /events (een gewone pagina, src/data/pages/events-home.ts of Sanity).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageSections from '../components/sections/PageSections.astro';
import { getHomePage } from '../lib/pages';
import { pageFacts } from '../lib/structured-data';

const page = await getHomePage();
const facts = await pageFacts('home', page.sections, Astro.site!);
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  ogImage={page.meta.ogImage}
  accent={page.accent}
  noindex={page.meta.noindex}
  structuredData={{ slug: page.slug, name: page.title, facts }}
  headerRevealAfter="[data-split-hero]"
>
  <PageSections sections={page.sections} breadcrumbs={[]} />
</BaseLayout>
