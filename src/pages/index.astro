---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import LogoMarquee from '../components/sections/LogoMarquee.astro';
import IntroHighlight from '../components/sections/IntroHighlight.astro';
import Timeline from '../components/sections/Timeline.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import PolaroidStack from '../components/sections/PolaroidStack.astro';
import TextMedia from '../components/sections/TextMedia.astro';
import * as localHome from '../data/home';
import { getHomepageContent } from '../lib/sanity/homepage';

/**
 * Proef: homepage-inhoud uit Sanity, met terugval op src/data/home.ts.
 * Zo blijft lokaal ontwikkelen zonder Sanity-account gewoon werken (zie docs/sanity.md),
 * en breekt de build niet als het Sanity-document nog niet bestaat.
 */
const sanityContent = await getHomepageContent();
const { meta, hero, trustedBy, intro, timeline, testimonials, backstage, micDrop } = sanityContent ?? localHome;
---

<BaseLayout title={meta.title} description={meta.description} ogImage={meta.ogImage}>
  <Hero {...hero} />
  <LogoMarquee {...trustedBy} />
  <IntroHighlight {...intro} />
  <Timeline {...timeline} />
  <Testimonials {...testimonials} />
  <PolaroidStack {...backstage} />
  <TextMedia {...micDrop} />
</BaseLayout>
