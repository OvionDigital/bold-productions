---
/**
 * Basislayout voor alle pagina's: <head> (meta, fonts-preload, favicons),
 * Header, Footer, WhatsApp-knop en de ene interactiebundel.
 */
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Analytics from '../components/layout/Analytics.astro';
import PageBackground from '../components/layout/PageBackground.astro';
import WhatsAppButton from '../components/layout/WhatsAppButton.astro';
import type { Accent } from '../components/ui/Button.astro';
import { buildStructuredData, type PageSchema, type Review } from '../lib/structured-data';
import { sectionOf, skipLinkLabel } from '../data/navigation';
import { getNavigation, getSocials } from '../lib/sanity/navigation';
import { isPreview } from '../lib/preview';
import ogDefault from '../assets/seo/og-default.jpg';
import logo from '../assets/brand/bold-productions-logo.png';
import { contact, copyright, credit, kvk, footerLogoAlt, header, legalLinks } from '../data/navigation';

interface Props {
  title: string;
  description: string;
  /** Absolute of site-relatieve URL van de social-share-afbeelding */
  ogImage?: string;
  /** Accentkleur van de pagina (events oranje, artiesten geel, zakelijk groen) */
  accent?: Accent;
  noindex?: boolean;
  /** Canonical naar een ander pad (kopie van een pagina, bijv. een case in een tweede soort) */
  canonicalPath?: string;
  /** Header, footer en WhatsApp-knop tonen (uit voor bijv. de styleguide) */
  chrome?: boolean;
  /** CSS-selector: navbar pas tonen als dit element voorbij is (homepage: '[data-split-hero]') */
  headerRevealAfter?: string;
  /** Voor preloads van het LCP-beeld per pagina */
  preloadImage?: { src: string; srcset?: string; sizes?: string; type?: string };
  /** Structured data (src/lib/structured-data.ts); niet op noindex-pagina's */
  structuredData?: {
    schema?: PageSchema;
    breadcrumbs?: { label: string; href?: string }[];
    website?: boolean;
    reviews?: Review[];
    catalog?: { name: string; items: { name: string; path: string }[] };
    employees?: string[];
    customers?: string[];
  };
}

const {
  title,
  description,
  ogImage,
  accent = 'orange',
  noindex = false,
  canonicalPath,
  chrome = true,
  headerRevealAfter,
  preloadImage,
  structuredData,
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '').replace(/\/$/, '') || '/';
// Zonder .html: de build (format 'file') geeft /events.html, Cloudflare serveert /events
const canonical = new URL(canonicalPath ?? currentPath, Astro.site);
// Menu, CTA en footer van dit deel van de site (events, business of neutraal), uit Sanity of src/data
const siteNav = (await getNavigation())[sectionOf(currentPath)];
const socials = await getSocials();
// Preview (Sanity Presentation): noindex en zonder animaties (is-static), zodat alle inhoud direct
// zichtbaar en aanklikbaar is en na elke wijziging op dezelfde plek terugkomt.
// Zonder eigen keuze: de vaste Bold-deelafbeelding (zoals live)
const ogImageUrl = new URL(ogImage ?? ogDefault.src, Astro.site).href;
const jsonLd =
  structuredData && !noindex
    ? buildStructuredData({
        site: Astro.site!,
        path: currentPath,
        title,
        description,
        logoUrl: new URL(logo.src, Astro.site).href,
        socials,
        ...structuredData,
      })
    : undefined;
// '<' escapen zodat tekst in de JSON nooit een </script> kan vormen
const jsonLdHtml = jsonLd ? JSON.stringify(jsonLd).replaceAll('<', String.fromCharCode(92) + 'u003c') : undefined;
---

<!doctype html>
<html lang="nl-NL" class:list={[isPreview && 'is-static']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || isPreview) && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bold Productions" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {jsonLdHtml && <script type="application/ld+json" is:inline set:html={jsonLdHtml} />}

    <!-- JS-vlag en statische modus (?static=1) vóór de eerste paint -->
    <script is:inline>
      document.documentElement.classList.add('js');
      if (new URLSearchParams(location.search).has('static')) document.documentElement.classList.add('is-static');
    </script>

    <!-- Gate normal + italic staan allebei boven de vouw (hero-titel) -->
    <link rel="preload" href="/fonts/gate-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/gate-400-italic.woff2" as="font" type="font/woff2" crossorigin />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage.src}
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          type={preloadImage.type}
          fetchpriority="high"
        />
      )
    }

    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-light-32.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-dark-32.png" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicons/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicons/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />

    <Analytics />
    <slot name="head" />
  </head>
  <body data-accent={accent}>
    <Analytics part="body" />
    <a href="#main" class="skip-link">{skipLinkLabel}</a>
    {
      chrome && (
        <Header
          nav={siteNav.nav}
          cta={siteNav.cta}
          home={siteNav.home}
          buttons={siteNav.buttons}
          switchTo={siteNav.switchTo}
          revealAfter={headerRevealAfter}
          menuLabel={header.menuLabel}
          logoAlt={header.logoAlt}
          homeTitle={header.homeTitle}
          currentPath={currentPath}
        />
      )
    }
    <PageBackground shapes={chrome ? undefined : false}>
      <main id="main">
        <slot />
      </main>
      {
        chrome && (
          <Footer
            columns={siteNav.footer}
            contact={contact}
            socials={socials}
            legalLinks={legalLinks}
            copyright={copyright}
            kvk={kvk}
            credit={credit}
            logoAlt={footerLogoAlt}
          />
        )
      }
    </PageBackground>
    {chrome && <WhatsAppButton href={contact.whatsapp.href} label={contact.whatsapp.label} />}

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
